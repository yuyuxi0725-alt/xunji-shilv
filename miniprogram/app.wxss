/* app.wxss —— 全局样式（古风暖色调） */
page {
  --color-primary: #8b5a2b;       /* 古铜棕，主色 */
  --color-accent: #b8860b;        /* 暗金，点缀 */
  --color-text: #3a3226;          /* 深褐，正文 */
  --color-text-secondary: #8c7b6b;/* 浅褐，次要文字 */
  --color-bg: #f5f0e8;            /* 宣纸色，背景 */
  --color-card: #fffdf7;          /* 卡片色 */
  --color-border: #e6dcc8;        /* 边框色 */
  --color-danger: #c0392b;
  --font-size-sm: 24rpx;
  --font-size-base: 28rpx;
  --font-size-lg: 32rpx;
  --font-size-xl: 40rpx;
  --spacing-base: 24rpx;
  --radius-base: 12rpx;
}

page {
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'STKaiti', 'KaiTi', serif;
  font-size: var(--font-size-base);
  color: var(--color-text);
  background-color: var(--color-bg);
  box-sizing: border-box;
  line-height: 1.6;
}

view, text, image, button, input, textarea, scroll-view {
  box-sizing: border-box;
}

/* 通用卡片 */
.card {
  background: var(--color-card);
  border-radius: var(--radius-base);
  padding: 24rpx;
  margin: 16rpx 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(139, 90, 43, 0.06);
}

/* 主按钮 */
.btn-primary {
  background: linear-gradient(135deg, #8b5a2b, #a9743c);
  color: #fff;
  border-radius: 44rpx;
  font-size: 30rpx;
  padding: 20rpx 0;
  text-align: center;
  border: none;
}
.btn-primary::after { border: none; }
.btn-primary[disabled] {
  background: #d8c9b4;
  color: #fff;
}

/* 安全区适配 */
.safe-area-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

/* 古风标题 */
.gufeng-title {
  font-family: 'STKaiti', 'KaiTi', serif;
  letter-spacing: 4rpx;
  color: var(--color-primary);
}
