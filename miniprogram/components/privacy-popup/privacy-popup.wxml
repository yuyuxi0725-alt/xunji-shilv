<!-- components/privacy-popup/privacy-popup.wxml -->
<view class="privacy-mask" wx:if="{{show}}" catchtouchmove="noop">
  <view class="privacy-dialog">
    <view class="privacy-title">隐私保护提示</view>
    <view class="privacy-body">
      在使用前，请你阅读并同意《隐私政策》。我们将识别你的 OpenID 用于同步学习档案、将学习进度保存至云端；你与 AI 的对话内容会发送给 DeepSeek 用于生成回复，并经过微信内容安全检测；仅在保存诗笺时才会访问你的相册。
    </view>
    <view class="privacy-link" bindtap="onOpenContract">查看《隐私政策》</view>
    <view class="privacy-actions">
      <button class="privacy-btn cancel" bindtap="onDisagree">拒绝</button>
      <button id="agree-btn" class="privacy-btn agree" open-type="agreePrivacyAuthorization" bindagreeprivacyauthorization="onAgree">同意并继续</button>
    </view>
  </view>
</view>
