/* pages/story/story.wxss —— 多主线选择 + 卷轴卡片时期列表 */

/* ============ 多主线选择视图 ============ */
.lines-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #2c3e50 0%, #3d2f22 260rpx, #2a2018 100%);
  padding-bottom: 40rpx;
}
.lines-head {
  padding: 90rpx 40rpx 50rpx;
  text-align: center;
}
.lines-title {
  font-size: 64rpx;
  color: #f0e6d2;
  letter-spacing: 10rpx;
  font-family: 'STKaiti', 'KaiTi', serif;
}
.lines-subtitle {
  margin-top: 16rpx;
  color: #c9b99a;
  font-size: 28rpx;
  letter-spacing: 4rpx;
}

.line-list {
  padding: 8rpx 40rpx 0;
}
.line-card {
  background: #fffdf6;
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 40rpx;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.3);
  border: 2rpx solid #e8dcc4;
  transition: transform 0.15s ease;
}
.line-card:active {
  transform: scale(0.98);
}
.line-card.coming {
  opacity: 0.8;
}

.line-thumb-wrap {
  position: relative;
  height: 320rpx;
}
.line-thumb {
  width: 100%;
  height: 100%;
}
.thumb-dim {
  filter: grayscale(0.5) brightness(0.8);
}
.line-overlay {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(40, 28, 16, 0.35);
}
.line-coming {
  padding: 10rpx 30rpx;
  border: 2rpx solid #f0e6d2;
  border-radius: 40rpx;
  color: #f0e6d2;
  font-size: 28rpx;
  letter-spacing: 4rpx;
}

.line-body {
  padding: 26rpx 30rpx 30rpx;
}
.line-name {
  font-size: 44rpx;
  color: #4a3220;
  font-family: 'STKaiti', 'KaiTi', serif;
  letter-spacing: 4rpx;
}
.line-tagline {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #9a7d54;
  letter-spacing: 2rpx;
}
.line-meta {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 24rpx;
  color: #a08c6b;
}
.line-enter {
  color: #b07b3e;
  font-weight: 600;
  font-size: 26rpx;
}

/* ============ 返回条 ============ */
.back-bar {
  padding: 24rpx 32rpx 8rpx;
  color: #c9b99a;
  font-size: 28rpx;
  display: flex;
  align-items: center;
}
.back-arrow {
  font-size: 40rpx;
  margin-right: 8rpx;
  line-height: 1;
}

/* ============ 卷轴时期列表（沿用原样式） ============ */
.page {
  min-height: 100vh;
  background: #3d2f22;
  display: flex;
  flex-direction: column;
  padding-bottom: 40rpx;
}

.scroll-rod {
  position: relative;
  height: 28rpx;
  margin: 0 12rpx;
  background: linear-gradient(180deg, #6b4a2e 0%, #8a6238 45%, #4a3220 100%);
  border-radius: 14rpx;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.35);
  z-index: 2;
}
.rod-top { margin-top: 24rpx; }
.rod-knob {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 34rpx;
  height: 52rpx;
  border-radius: 17rpx;
  background: linear-gradient(180deg, #8a6238 0%, #5a3d26 100%);
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.4);
}
.knob-left { left: -18rpx; }
.knob-right { right: -18rpx; }

.scroll-paper {
  flex: 1;
  margin: 0 24rpx;
  background: linear-gradient(180deg, #f8f2e3 0%, #f3ebd8 100%);
  box-shadow: 0 6rpx 18rpx rgba(0, 0, 0, 0.3);
  padding-bottom: 48rpx;
}

.story-head {
  padding: 48rpx 40rpx 32rpx;
  text-align: center;
}
.story-title {
  font-size: 52rpx;
  color: #4a3220;
  font-family: 'STKaiti', 'KaiTi', serif;
  letter-spacing: 8rpx;
}
.story-subtitle {
  margin-top: 10rpx;
  color: #9a7d54;
  font-size: 26rpx;
  letter-spacing: 4rpx;
}

.progress-wrap {
  margin-top: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.progress-bar {
  width: 320rpx;
  height: 14rpx;
  background: #e4d8bf;
  border-radius: 7rpx;
  overflow: hidden;
}
.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #b07b3e 0%, #8b5a2b 100%);
  border-radius: 7rpx;
  transition: width 0.4s ease;
}
.progress-text {
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #9a7d54;
}

.period-list {
  padding: 8rpx 28rpx 0;
}
.period-card {
  background: #fffdf6;
  border-radius: 18rpx;
  overflow: hidden;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 14rpx rgba(74, 50, 32, 0.12);
  border: 2rpx solid #e8dcc4;
  transition: transform 0.15s ease;
}
.period-card:active {
  transform: scale(0.985);
}
.period-card.active {
  border: 3rpx solid #b07b3e;
  box-shadow: 0 6rpx 20rpx rgba(139, 90, 43, 0.28);
}
.period-card.locked {
  opacity: 0.75;
}

.card-thumb-wrap {
  position: relative;
  height: 260rpx;
}
.card-thumb {
  width: 100%;
  height: 100%;
}
.thumb-locked {
  filter: grayscale(0.9) brightness(0.75);
}
.thumb-overlay {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(40, 28, 16, 0.35);
}
.lock-icon { font-size: 52rpx; }
.lock-text {
  margin-top: 8rpx;
  color: #f0e6d2;
  font-size: 24rpx;
  letter-spacing: 2rpx;
}

.state-badge {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  color: #fff;
}
.badge-done { background: rgba(107, 142, 90, 0.92); }
.badge-active { background: rgba(176, 123, 62, 0.92); }

.chapter-seal {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(158, 42, 43, 0.88);
  color: #f5e9d5;
  font-size: 34rpx;
  font-family: 'STKaiti', 'KaiTi', serif;
  border-radius: 10rpx;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.25);
}

.card-body {
  padding: 24rpx 28rpx 26rpx;
}
.card-title-row {
  display: flex;
  align-items: baseline;
}
.card-name {
  font-size: 38rpx;
  color: #4a3220;
  font-family: 'STKaiti', 'KaiTi', serif;
  letter-spacing: 3rpx;
}
.card-range {
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #b07b3e;
}
.card-poem {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #7a6446;
  font-family: 'STKaiti', 'KaiTi', serif;
  letter-spacing: 1rpx;
}
.card-desc-row {
  margin-top: 14rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.card-desc {
  font-size: 24rpx;
  color: #a08c6b;
}
.card-enter {
  font-size: 26rpx;
  color: #b07b3e;
  font-weight: 600;
}
.period-card.locked .card-enter {
  display: none;
}

.loading-tip {
  text-align: center;
  color: #c9b99a;
  padding: 40rpx;
}
