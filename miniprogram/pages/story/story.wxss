/* pages/story/story.wxss —— 多主线选择 + 卷轴卡片时期列表 */

/* ============ 多主线选择视图 ============ */
.lines-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #2c3e50 0%, #3d2f22 260rpx, #2a2018 100%);
  padding-bottom: 40rpx;
}
.lines-head {
  padding: 70rpx 40rpx 30rpx;
  text-align: center;
}
.lines-title {
  font-size: 64rpx;
  color: #f0e6d2;
  letter-spacing: 10rpx;
  font-family: 'STKaiti', 'KaiTi', serif;
}
.lines-subtitle {
  margin-top: 16rpx;
  color: #c9b99a;
  font-size: 28rpx;
  letter-spacing: 4rpx;
}

/* 诗人卡牌滑动区 */
.line-swiper {
  height: 880rpx;
}
.poet-card {
  height: 100%;
  padding: 24rpx 0;
  box-sizing: border-box;
}
.poet-card-face {
  position: relative;
  height: 640rpx;
  border-radius: 24rpx;
  overflow: hidden;
  border: 3rpx solid #e6cf9a;
  box-shadow: 0 10rpx 34rpx rgba(0, 0, 0, 0.42);
  transition: transform 0.32s ease, opacity 0.32s ease;
}
.poet-card.is-center .poet-card-face {
  transform: scale(1);
}
.poet-card.is-side .poet-card-face {
  transform: scale(0.9);
  opacity: 0.72;
}
.poet-bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}
.poet-bg-mask {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(30, 22, 14, 0.06) 0%, rgba(30, 22, 14, 0) 40%, rgba(30, 22, 14, 0.22) 100%);
}
.poet-frame {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 560rpx;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.poet-portrait {
  width: 100%;
  height: 100%;
  filter: drop-shadow(0 12rpx 22rpx rgba(20, 12, 4, 0.45));
}
.portrait-dim {
  filter: grayscale(0.55) brightness(0.82) drop-shadow(0 12rpx 22rpx rgba(20, 12, 4, 0.45));
}
.poet-seal {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  border-radius: 10rpx;
  background: rgba(158, 42, 34, 0.88);
  color: #f5e9d5;
  font-size: 34rpx;
  font-family: 'STKaiti', 'KaiTi', serif;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.3);
}
.poet-overlay {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(40, 28, 16, 0.3);
}
.poet-coming {
  padding: 12rpx 34rpx;
  border: 2rpx solid #f0e6d2;
  border-radius: 40rpx;
  color: #f0e6d2;
  font-size: 30rpx;
  letter-spacing: 4rpx;
}

.poet-info {
  margin-top: 6rpx;
  text-align: center;
}
.poet-name {
  font-size: 50rpx;
  color: #f5ecd9;
  font-family: 'STKaiti', 'KaiTi', serif;
  letter-spacing: 8rpx;
}
.poet-tagline {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #c9b99a;
  letter-spacing: 4rpx;
}
.poet-meta {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 28rpx;
  font-size: 26rpx;
  color: #b59a72;
}
.poet-enter {
  color: #d8b06a;
  font-weight: 600;
  font-size: 28rpx;
}

.line-dots {
  margin-top: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}
.line-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: rgba(201, 185, 154, 0.45);
  transition: all 0.25s ease;
}
.line-dot.dot-on {
  width: 36rpx;
  border-radius: 7rpx;
  background: #d8b06a;
}
.lines-hint {
  margin-top: 18rpx;
  text-align: center;
  color: #a9946f;
  font-size: 24rpx;
  letter-spacing: 3rpx;
}

/* ============ 返回条 ============ */
.back-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 10;
  padding: calc(env(safe-area-inset-top) + 20rpx) 32rpx 16rpx;
  color: #c9b99a;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  background: #3d2f22;
}
.back-arrow {
  font-size: 40rpx;
  margin-right: 8rpx;
  line-height: 1;
}

/* ============ 卷轴时期列表（沿用原样式） ============ */
.page {
  min-height: 100vh;
  background: #3d2f22;
  display: flex;
  flex-direction: column;
  padding-bottom: 40rpx;
  padding-top: calc(env(safe-area-inset-top) + 132rpx);
}

.scroll-rod {
  position: relative;
  height: 28rpx;
  margin: 0 12rpx;
  background: linear-gradient(180deg, #6b4a2e 0%, #8a6238 45%, #4a3220 100%);
  border-radius: 14rpx;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.35);
  z-index: 2;
}
.rod-top { margin-top: 24rpx; }
.rod-knob {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 34rpx;
  height: 52rpx;
  border-radius: 17rpx;
  background: linear-gradient(180deg, #8a6238 0%, #5a3d26 100%);
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.4);
}
.knob-left { left: -18rpx; }
.knob-right { right: -18rpx; }

.scroll-paper {
  flex: 1;
  margin: 0 24rpx;
  background: linear-gradient(180deg, #f8f2e3 0%, #f3ebd8 100%);
  box-shadow: 0 6rpx 18rpx rgba(0, 0, 0, 0.3);
  padding-bottom: 48rpx;
}

.story-head {
  padding: 48rpx 40rpx 32rpx;
  text-align: center;
}
.story-title {
  font-size: 52rpx;
  color: #4a3220;
  font-family: 'STKaiti', 'KaiTi', serif;
  letter-spacing: 8rpx;
}
.story-subtitle {
  margin-top: 10rpx;
  color: #9a7d54;
  font-size: 26rpx;
  letter-spacing: 4rpx;
}

.progress-wrap {
  margin-top: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.progress-bar {
  width: 320rpx;
  height: 14rpx;
  background: #e4d8bf;
  border-radius: 7rpx;
  overflow: hidden;
}
.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #b07b3e 0%, #8b5a2b 100%);
  border-radius: 7rpx;
  transition: width 0.4s ease;
}
.progress-text {
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #9a7d54;
}

.period-list {
  padding: 8rpx 28rpx 0;
}
.period-card {
  background: #fffdf6;
  border-radius: 18rpx;
  overflow: hidden;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 14rpx rgba(74, 50, 32, 0.12);
  border: 2rpx solid #e8dcc4;
  transition: transform 0.15s ease;
}
.period-card:active {
  transform: scale(0.985);
}
.period-card.active {
  border: 3rpx solid #b07b3e;
  box-shadow: 0 6rpx 20rpx rgba(139, 90, 43, 0.28);
}
.period-card.locked {
  opacity: 0.75;
}

.card-thumb-wrap {
  position: relative;
  height: 260rpx;
}
.card-thumb {
  width: 100%;
  height: 100%;
}
.thumb-locked {
  filter: grayscale(0.9) brightness(0.75);
}
.thumb-overlay {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(40, 28, 16, 0.35);
}
.lock-icon { font-size: 52rpx; }
.lock-text {
  margin-top: 8rpx;
  color: #f0e6d2;
  font-size: 24rpx;
  letter-spacing: 2rpx;
}

.state-badge {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  color: #fff;
}
.badge-done { background: rgba(107, 142, 90, 0.92); }
.badge-active { background: rgba(176, 123, 62, 0.92); }

.chapter-seal {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(158, 42, 43, 0.88);
  color: #f5e9d5;
  font-size: 34rpx;
  font-family: 'STKaiti', 'KaiTi', serif;
  border-radius: 10rpx;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.25);
}

.card-body {
  padding: 24rpx 28rpx 26rpx;
}
.card-title-row {
  display: flex;
  align-items: baseline;
}
.card-name {
  font-size: 38rpx;
  color: #4a3220;
  font-family: 'STKaiti', 'KaiTi', serif;
  letter-spacing: 3rpx;
}
.card-range {
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #b07b3e;
}
.card-poem {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #7a6446;
  font-family: 'STKaiti', 'KaiTi', serif;
  letter-spacing: 1rpx;
}
.card-desc-row {
  margin-top: 14rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.card-desc {
  font-size: 24rpx;
  color: #a08c6b;
}
.card-enter {
  font-size: 26rpx;
  color: #b07b3e;
  font-weight: 600;
}
.period-card.locked .card-enter {
  display: none;
}

.loading-tip {
  text-align: center;
  color: #c9b99a;
  padding: 40rpx;
}
