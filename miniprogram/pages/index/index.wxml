<!-- pages/index/index.wxml —— 首页（动态封面） -->
<view class="page">

  <!-- ===== 封面层 ===== -->
  <view class="cover">
    <!-- 背景：动态视频（云存储） + 静态竖版图兜底 -->
    <!-- 视频未取到链接时由下方 cover-bg 静态图兜底，poster 不支持本地路径故不用 -->
    <video
      class="cover-video"
      src="{{coverVideoUrl}}"
      autoplay
      loop
      muted
      object-fit="cover"
      show-center-play-btn="{{false}}"
      show-fullscreen-btn="{{false}}"
      show-play-btn="{{false}}"
      controls="{{false}}"
      binderror="onVideoError"
    ></video>
    <!-- 视频尚未取到链接时，显示静态底图（视频 ready 后覆盖其上） -->
    <image
      class="cover-bg"
      wx:if="{{!coverVideoUrl}}"
      src="{{coverImage}}"
      mode="aspectFill"
    />

    <!-- 渐变遮罩（让文字清晰） -->
    <view class="cover-mask"></view>

    <!-- 标题区 -->
    <view class="cover-title-wrap">
      <!-- 标题改用艺术字图片（本地小图，不依赖云链接，保证首屏必显） -->
      <image class="cover-title-img" src="/assets/brand/title-logo.png" mode="widthFix" />
      <view class="cover-subtitle">一梦千年，与先贤同游</view>
    </view>

    <!-- 登录 / 入口 -->
    <view class="cover-action">
      <view class="age-notice">适龄提示 · 本服务面向年满14周岁用户</view>
      <button class="btn-start {{(!agreementChecked || !ageConfirmed) ? 'btn-start-disabled' : ''}}" bindtap="onStart" loading="{{logging}}">开始穿越之旅</button>
      <checkbox-group class="age-row" bindchange="onAgeChange">
        <label class="agreement-label">
          <checkbox
            class="agreement-checkbox"
            value="age14"
            checked="{{ageConfirmed}}"
            color="#b07b3e"
          />
          <text>我确认已满14周岁</text>
        </label>
      </checkbox-group>
      <checkbox-group class="agreement-row" bindchange="onAgreementChange">
        <label class="agreement-label">
          <checkbox
            class="agreement-checkbox"
            value="agree"
            checked="{{agreementChecked}}"
            color="#b07b3e"
          />
          <text>我已阅读并同意</text>
        </label>
        <navigator url="/pages/agreement/agreement" class="privacy-link">《用户服务协议》</navigator>
        <text class="agreement-and">和</text>
        <text class="privacy-link" bindtap="onOpenPrivacy">《隐私政策》</text>
      </checkbox-group>
      <view class="agreement-hint">两项均由本人自主确认；未勾选不会登录或收集账号标识</view>
    </view>
  </view>

  <!-- 微信官方隐私授权弹窗（隐私接口调用前统一同步授权状态） -->
  <privacy-popup />
</view>
