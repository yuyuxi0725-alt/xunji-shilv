/* pages/index/index.wxss —— 首页（动态封面 + 穿越开场动画） */

.page {
  position: relative;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background: #1a1613;
}

/* ============ 封面层 ============ */
.cover {
  position: absolute;
  inset: 0;
}
.cover-bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}
.cover-video {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}
.cover-mask {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(20, 14, 8, 0.55) 0%, rgba(20, 14, 8, 0.1) 40%, rgba(20, 14, 8, 0.65) 100%);
}

/* 标题（系统楷体，整齐统一） */
.cover-title-wrap {
  position: absolute;
  top: 150rpx;
  left: 0;
  right: 0;
  text-align: center;
  z-index: 3;
}
.cover-title {
  color: #f5ead3;
  font-size: 112rpx;
  font-weight: 700;
  letter-spacing: 10rpx;
  font-family: 'STKaiti', 'KaiTi', 'FangSong', 'STFangsong', serif;
  text-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.7);
  animation: titleIn 0.9s ease both;
}
.cover-subtitle {
  margin-top: 30rpx;
  color: #fff8ec;
  font-size: 38rpx;
  letter-spacing: 4rpx;
  font-family: 'STKaiti', 'KaiTi', 'FangSong', serif;
  text-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.7);
  animation: titleIn 0.9s 0.2s ease both;
}
@keyframes titleIn {
  from { opacity: 0; transform: translateY(30rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* 操作区（贴底部安全区，避开封面中同学的脸） */
.cover-action {
  position: absolute;
  left: 0;
  right: 0;
  bottom: calc(env(safe-area-inset-bottom) + 48rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 80rpx;
  z-index: 3;
}
.btn-start {
  width: 480rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  line-height: 1;
  background: linear-gradient(135deg, #b07b3e 0%, #8b5a2b 100%);
  color: #fff7ea;
  font-size: 38rpx;
  letter-spacing: 4rpx;
  font-family: 'STKaiti', 'KaiTi', 'FangSong', serif;
  border-radius: 48rpx;
  box-shadow: 0 8rpx 24rpx rgba(139, 90, 43, 0.45);
}
.btn-start::after { border: none; }
.privacy-tip {
  margin-top: 20rpx;
  font-size: 22rpx;
  color: #b5a892;
}
.privacy-link {
  color: #d8a95e;
  display: inline;
}

/* ============ 穿越开场动画层 ============ */
/* 初始透明：让封面透出，墨晕从封面漩涡中心漫开 */
.portal-layer {
  position: absolute;
  inset: 0;
  background: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
  overflow: hidden;
  transition: opacity 0.3s ease;
}
/* 切页前的淡出 */
.portal-layer.portal-fade {
  opacity: 0;
}

/* ---------- 墨晕层：三层径向墨团错峰晕开，最终漫满全屏 ---------- */
.portal-ink {
  position: absolute;
  left: 50%;
  top: 42%;   /* 封面漩涡中心的大致位置 */
  width: 140vmax;
  height: 140vmax;
  border-radius: 50%;
  background: radial-gradient(circle,
    rgba(16, 12, 8, 0.96) 0%,
    rgba(20, 15, 9, 0.9) 34%,
    rgba(24, 18, 11, 0.72) 52%,
    rgba(24, 18, 11, 0) 70%);
  transform: translate(-50%, -50%) scale(0.08);
  opacity: 0;
  animation: inkSpread 1.5s cubic-bezier(0.3, 0, 0.4, 1) both;
  pointer-events: none;
}
.ink-1 { animation-delay: 0.05s; }
.ink-2 {
  background: radial-gradient(circle,
    rgba(26, 20, 12, 0.94) 0%,
    rgba(30, 23, 14, 0.85) 40%,
    rgba(30, 23, 14, 0) 66%);
  animation-delay: 0.28s;
  animation-duration: 1.7s;
}
.ink-3 {
  background: radial-gradient(circle,
    rgba(12, 9, 6, 0.98) 0%,
    rgba(14, 11, 7, 0.92) 46%,
    rgba(14, 11, 7, 0) 72%);
  animation-delay: 0.5s;
  animation-duration: 1.9s;
}
@keyframes inkSpread {
  0%   { transform: translate(-50%, -50%) scale(0.08); opacity: 0; }
  18%  { opacity: 1; }
  100% { transform: translate(-50%, -50%) scale(1); opacity: 1; }
}

/* ---------- 卷轴：轴杆自中央向上下展开，纸面随之铺陈 ---------- */
.portal-scroll {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  pointer-events: none;
}
.portal-rod {
  position: absolute;
  left: 4%;
  right: 4%;
  height: 34rpx;
  border-radius: 18rpx;
  background: linear-gradient(180deg, #6d4a28 0%, #3d2814 55%, #241708 100%);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.6), inset 0 2rpx 4rpx rgba(255, 220, 160, 0.25);
  z-index: 3;
  animation: rodSpin 1.1s cubic-bezier(0.25, 0.9, 0.3, 1) both;
}
.rod-top { top: 50%; }
.rod-bottom { top: 50%; }
@keyframes rodSpin {
  from { transform: translateY(-50%) scaleX(0.2); opacity: 0; }
  30%  { opacity: 1; }
  to   { transform: translateY(-50%) scaleX(1); opacity: 1; }
}
.portal-rod.rod-top {
  animation-name: rodUp;
}
.portal-rod.rod-bottom {
  animation-name: rodDown;
}
@keyframes rodUp {
  from { top: 50%; transform: translateY(-50%) scaleX(0.2); opacity: 0; }
  25%  { opacity: 1; }
  to   { top: 13%; transform: translateY(0) scaleX(1); opacity: 1; }
}
@keyframes rodDown {
  from { top: 50%; transform: translateY(-50%) scaleX(0.2); opacity: 0; }
  25%  { opacity: 1; }
  to   { top: 87%; transform: translateY(0) scaleX(1); opacity: 1; }
}
.rod-knob {
  position: absolute;
  top: -10rpx;
  width: 54rpx;
  height: 54rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 35% 35%, #8a6234 0%, #4a3018 60%, #2a1a0a 100%);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.55);
}
.k-l { left: -14rpx; }
.k-r { right: -14rpx; }

/* 卷轴纸面：跟随轴杆展开（宣纸色 + 纸纹） */
.portal-paper {
  position: absolute;
  left: 5%;
  right: 5%;
  top: 50%;
  bottom: 50%;
  background:
    repeating-linear-gradient(0deg, rgba(120, 90, 50, 0.035) 0 3rpx, transparent 3px 7rpx),
    linear-gradient(180deg, #efe2c4 0%, #e8d8b4 46%, #dfcca2 100%);
  border-radius: 10rpx;
  box-shadow: 0 0 60rpx rgba(0, 0, 0, 0.55), inset 0 0 80rpx rgba(120, 85, 40, 0.22);
  display: flex;
  flex-direction: column;
  align-items: center;
  overflow: hidden;
  z-index: 2;
  animation: paperUnroll 1.15s cubic-bezier(0.25, 0.9, 0.3, 1) both;
}
@keyframes paperUnroll {
  from { top: 50%; bottom: 50%; opacity: 0; }
  12%  { opacity: 1; }
  to   { top: 14.5%; bottom: 14.5%; opacity: 1; }
}

/* 卷首朱印 */
.paper-seal {
  margin-top: 5%;
  width: 84rpx;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  border-radius: 12rpx;
  background: rgba(158, 42, 34, 0.85);
  color: #f6ead6;
  font-size: 52rpx;
  font-family: 'STKaiti', 'KaiTi', 'FangSong', serif;
  box-shadow: 0 2rpx 10rpx rgba(120, 30, 24, 0.4);
  opacity: 0;
  animation: sealIn 0.5s 1.15s ease both;
}
@keyframes sealIn {
  from { opacity: 0; transform: scale(1.6) rotate(-8deg); }
  to   { opacity: 1; transform: scale(1) rotate(0deg); }
}

/* 诗句逐行浮现 */
.paper-poem {
  color: #4a3418;
  font-family: 'STKaiti', 'KaiTi', 'FangSong', serif;
  opacity: 0;
  animation: poemIn 0.8s ease both;
}
.poem-l1 {
  margin-top: 4%;
  font-size: 72rpx;
  letter-spacing: 22rpx;
  font-weight: 700;
  animation-delay: 1.25s;
}
.poem-l2 {
  margin-top: 26rpx;
  font-size: 34rpx;
  letter-spacing: 8rpx;
  color: #6b4f28;
  animation-delay: 1.5s;
}
@keyframes poemIn {
  from { opacity: 0; transform: translateY(24rpx); filter: blur(4rpx); }
  to   { opacity: 1; transform: translateY(0); filter: blur(0); }
}

/* 众古人像：卷轴纸面内浮现定格（不再上飘消失） */
.portal-figures {
  margin-top: 5%;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  gap: 44rpx;
}
.pf {
  width: 150rpx;
  height: 220rpx;
  opacity: 0;
  animation: figureIn 0.9s ease both;
}
.pf image {
  width: 100%;
  height: 100%;
  filter: drop-shadow(0 6rpx 14rpx rgba(60, 40, 15, 0.4));
}
.pf-1 { animation-delay: 1.7s; }
.pf-2 { animation-delay: 1.9s; }
.pf-3 { animation-delay: 2.1s; }
@keyframes figureIn {
  from { opacity: 0; transform: translateY(36rpx) scale(0.86); }
  to   { opacity: 1; transform: translateY(0) scale(1); }
}

/* ---------- 收束白光：定格后整体泛白，接入剧本页 ---------- */
.portal-flash {
  position: absolute;
  inset: 0;
  background: radial-gradient(circle at center, rgba(245, 234, 211, 0.95) 0%, rgba(245, 234, 211, 0.75) 60%, rgba(230, 210, 170, 0.6) 100%);
  opacity: 0;
  animation: flashIn 0.8s 2.55s ease both;
  z-index: 5;
  pointer-events: none;
}
@keyframes flashIn {
  from { opacity: 0; }
  to   { opacity: 1; }
}
