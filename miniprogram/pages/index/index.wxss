/* pages/index/index.wxss —— 首页（动态封面） */

.page {
  position: relative;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background: #1a1613;
}

/* ============ 封面层 ============ */
.cover {
  position: absolute;
  inset: 0;
  /* 用户同意前不请求云端封面，先用纯 CSS 背景保证首屏完整可读。 */
  background:
    radial-gradient(circle at 50% 42%, rgba(142, 101, 59, 0.58) 0%, rgba(55, 39, 27, 0.78) 38%, #1a1613 78%),
    #1a1613;
}
.cover-bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}
.cover-video {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}
.cover-mask {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(20, 14, 8, 0.55) 0%, rgba(20, 14, 8, 0.1) 40%, rgba(20, 14, 8, 0.65) 100%);
}

/* 标题（系统楷体，整齐统一） */
.cover-title-wrap {
  position: absolute;
  top: 150rpx;
  left: 0;
  right: 0;
  text-align: center;
  z-index: 3;
}
/* 标题改为艺术字图片：宽度定死、高度按 widthFix 自适应（原图 708×239） */
.cover-title-img {
  display: block;
  width: 560rpx;
  margin: 0 auto;
  animation: titleIn 0.9s ease both;
}
.cover-subtitle {
  margin-top: 30rpx;
  color: #fff8ec;
  font-size: 38rpx;
  letter-spacing: 4rpx;
  font-family: 'STKaiti', 'KaiTi', 'FangSong', serif;
  text-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.7);
  animation: titleIn 0.9s 0.2s ease both;
}
@keyframes titleIn {
  from { opacity: 0; transform: translateY(30rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* 操作区（贴底部安全区，避开封面中同学的脸） */
.cover-action {
  position: absolute;
  left: 0;
  right: 0;
  bottom: calc(env(safe-area-inset-bottom) + 48rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 80rpx;
  z-index: 3;
}
.btn-start {
  width: 480rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  line-height: 1;
  background: linear-gradient(135deg, #b07b3e 0%, #8b5a2b 100%);
  color: #fff7ea;
  font-size: 38rpx;
  letter-spacing: 4rpx;
  font-family: 'STKaiti', 'KaiTi', 'FangSong', serif;
  border-radius: 48rpx;
  box-shadow: 0 8rpx 24rpx rgba(139, 90, 43, 0.45);
}
.btn-start::after { border: none; }
.btn-start-disabled {
  opacity: 0.72;
}
.age-notice {
  margin-bottom: 16rpx;
  padding: 8rpx 22rpx;
  border: 1rpx solid rgba(216, 169, 94, 0.65);
  border-radius: 28rpx;
  background: rgba(24, 18, 12, 0.66);
  color: #f0d5a4;
  font-size: 23rpx;
  line-height: 34rpx;
  letter-spacing: 1rpx;
}
.age-row {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #f0e5d2;
  font-size: 24rpx;
  line-height: 38rpx;
}
.agreement-row {
  margin-top: 8rpx;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #e4d8c5;
  line-height: 40rpx;
}
.agreement-label {
  display: flex;
  align-items: center;
}
.agreement-checkbox {
  margin-right: 8rpx;
  transform: scale(0.78);
  transform-origin: center;
}
.agreement-and {
  margin: 0 4rpx;
}
.privacy-link {
  color: #d8a95e;
  display: inline;
}
.agreement-hint {
  margin-top: 8rpx;
  color: #c7baa6;
  font-size: 20rpx;
  text-align: center;
  line-height: 32rpx;
}
