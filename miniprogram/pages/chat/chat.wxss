  border: none;
}

/* ============================================================
   节点检验（由史料卡动态出题，答完才放行"继续剧情"）
   ============================================================ */
.vn-quiz {
  padding: 20rpx 24rpx;
  background: rgba(26, 22, 18, 0.94);
  border-top: 1rpx solid rgba(200, 170, 110, 0.25);
}
.vn-quiz-tag {
  font-size: 23rpx;
  color: #d8b878;
  letter-spacing: 2rpx;
  margin-bottom: 12rpx;
  font-family: 'STKaiti', 'KaiTi', serif;
}
.vn-quiz-q {
  font-size: 27rpx;
  line-height: 1.6;
  color: #f5eddc;
  margin-bottom: 16rpx;
  font-family: 'STKaiti', 'KaiTi', serif;
}
.vn-quiz-opt {
  padding: 14rpx 22rpx;
  margin-bottom: 12rpx;
  border-radius: 12rpx;
  border: 1rpx solid rgba(200, 170, 110, 0.3);
  background: rgba(255, 253, 247, 0.06);
  color: #e8dcc4;
  font-size: 26rpx;
  line-height: 1.5;
}
.vn-quiz-opt.picked-right {
  border-color: #7fae6a;
  background: rgba(127, 174, 106, 0.22);
  color: #e6f5dd;
}
.vn-quiz-opt.picked-wrong {
  border-color: #b06a6a;
  background: rgba(176, 106, 106, 0.2);
  color: #f6dede;
}
.vn-quiz-opt.is-answer {
  border-color: #c8aa6e;
  box-shadow: inset 0 0 0 1rpx rgba(200, 170, 110, 0.5);
}
.vn-quiz-explain {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #cbb894;
  font-family: 'STKaiti', 'KaiTi', serif;
}

/* ============ 角色姓名条（杜甫线，不显示职业/信任/任务） ============ */
/* 顶部标题下方；避开胶囊与标题，显示「同行者 · 姓名」 */
.vn-rolebar {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  z-index: 18;                /* 高于背景，低于对话框(20)，不挡交互 */
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 8rpx;
  pointer-events: none;       /* 整条只展示，不拦截点击 */
}
.vn-role-tag {
  font-size: 22rpx;
  color: #e8d9bd;
  background: rgba(26, 22, 18, 0.72);
  border: 1rpx solid rgba(200, 170, 110, 0.4);
  border-radius: 8rpx;
  padding: 4rpx 16rpx;
  font-family: 'STKaiti', 'KaiTi', serif;
}
