/* pages/poem/poem.wxss —— 我的诗笺（知识印谱 + 竖排诗句） */

.page {
  min-height: 100vh;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  background: #f5f0e8;
}

/* ===== 诗人分册 tab ===== */
.line-tabs {
  display: flex;
  padding: 20rpx 24rpx 0;
}
.line-tab {
  flex: 1;
  margin-right: 16rpx;
  padding: 18rpx 0 14rpx;
  border-radius: 14rpx;
  background: #fffdf7;
  text-align: center;
  box-shadow: 0 4rpx 14rpx rgba(70, 45, 24, 0.06);
}
.line-tab:last-child { margin-right: 0; }
.line-tab.on {
  background: linear-gradient(160deg, #3b2d1c 0%, #68482d 100%);
}
.line-tab-name {
  font-size: 27rpx;
  color: #6d5842;
  font-family: 'STKaiti', 'KaiTi', serif;
  letter-spacing: 3rpx;
}
.line-tab.on .line-tab-name { color: #fff8ea; }
.line-tab-count {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #ac9b87;
}
.line-tab.on .line-tab-count { color: #e1bd79; }

/* ===== 印谱正文 ===== */
.book-body {
  margin: 20rpx 24rpx 0;
  padding: 12rpx 28rpx 28rpx;
  border-radius: 18rpx;
  background: #fffdf7;
  box-shadow: 0 8rpx 28rpx rgba(70, 45, 24, 0.12);
}
.period { padding-top: 30rpx; }
.period + .period {
  margin-top: 8rpx;
  border-top: 1rpx solid #e6dcc8;
}
.period-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 8rpx;
}
.period-name {
  font-size: 29rpx;
  color: #8b5a2b;
  font-family: 'STKaiti', 'KaiTi', serif;
  letter-spacing: 3rpx;
}
.period-range {
  font-size: 20rpx;
  color: #ac9b87;
}

.imprint {
  display: flex;
  align-items: flex-start;
  padding: 24rpx 0;
  border-top: 1rpx solid rgba(230, 220, 200, 0.72);
}
.period-head + .imprint { border-top: none; }
.imprint:active { opacity: 0.66; }
.imprint-seal {
  flex-shrink: 0;
  margin-top: 3rpx;
  padding: 5rpx 10rpx;
  border: 1rpx solid rgba(163, 58, 43, 0.42);
  border-radius: 4rpx;
  color: #a33a2b;
  font-size: 18rpx;
  line-height: 1.35;
}
.imprint-main {
  min-width: 0;
  flex: 1;
  margin-left: 18rpx;
}
.imprint-title-row {
  display: flex;
  align-items: center;
}
.imprint-title {
  min-width: 0;
  font-size: 28rpx;
  color: #3a3226;
  font-family: 'STKaiti', 'KaiTi', serif;
  letter-spacing: 1rpx;
}
.poem-tag {
  flex-shrink: 0;
  margin-left: 10rpx;
  padding: 2rpx 8rpx;
  border-radius: 10rpx;
  color: #9b6a32;
  background: #f3e8d5;
  font-size: 18rpx;
}
.imprint-know {
  margin-top: 8rpx;
  color: #8c7b6b;
  font-size: 23rpx;
  line-height: 1.55;
}
.imprint-arrow {
  flex-shrink: 0;
  margin: 22rpx 0 0 14rpx;
  color: #b7a590;
  font-size: 34rpx;
}

/* ===== 竖排诗句（诗笺视觉灵魂，仅挂 poem 的印记展示） ===== */
.imprint-poem {
  margin-top: 16rpx;
  padding: 16rpx 18rpx;
  border-left: 3rpx solid rgba(163, 58, 43, 0.28);
  border-radius: 0 10rpx 10rpx 0;
  background: rgba(163, 58, 43, 0.045);
}
.ip-poem-title {
  color: #4a3520;
  font-size: 22rpx;
  font-family: 'STKaiti', 'KaiTi', serif;
  letter-spacing: 1rpx;
}
.ip-poem-lines { margin-top: 10rpx; }
.ip-poem-line {
  color: #5c4b39;
  text-align: center;
  font-size: 25rpx;
  line-height: 1.8;
  font-family: 'STKaiti', 'KaiTi', serif;
}
.ip-poem-line.hi { color: #a33a2b; }

/* ===== 空态 ===== */
.empty {
  margin: 80rpx 72rpx 0;
  text-align: center;
}
.empty-seal {
  width: 96rpx;
  height: 96rpx;
  margin: 0 auto;
  border: 3rpx double rgba(163, 58, 43, 0.48);
  color: rgba(163, 58, 43, 0.58);
  font-size: 48rpx;
  line-height: 90rpx;
  font-family: 'STKaiti', 'KaiTi', serif;
  transform: rotate(-4deg);
}
.empty-title {
  margin-top: 26rpx;
  color: #6d5842;
  font-size: 30rpx;
  letter-spacing: 4rpx;
}
.empty-text {
  margin-top: 14rpx;
  color: #a18f7b;
  font-size: 24rpx;
  line-height: 1.8;
}
.empty-btn {
  display: inline-block;
  margin-top: 30rpx;
  padding: 16rpx 48rpx;
  border-radius: 30rpx;
  color: #fffaf0;
  background: linear-gradient(135deg, #8b5a2b, #a9743c);
  font-size: 25rpx;
}

/* ===== 完整史料弹窗 ===== */
.detail-mask {
  position: fixed;
  z-index: 100;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 76rpx 44rpx calc(76rpx + env(safe-area-inset-bottom));
  background: rgba(20, 15, 10, 0.72);
}
.detail-card {
  width: 100%;
  max-height: 78vh;
  padding: 36rpx 34rpx 30rpx;
  border: 1rpx solid #decbaa;
  border-radius: 18rpx;
  background: #fffaf0;
  box-shadow: 0 18rpx 48rpx rgba(0, 0, 0, 0.34);
}
.detail-seal {
  display: inline-block;
  padding: 5rpx 12rpx;
  border: 2rpx solid rgba(163, 58, 43, 0.56);
  border-radius: 4rpx;
  color: #a33a2b;
  font-size: 19rpx;
  letter-spacing: 2rpx;
}
.detail-name {
  margin-top: 14rpx;
  color: #3a2a1a;
  font-size: 38rpx;
  font-family: 'STKaiti', 'KaiTi', serif;
  letter-spacing: 2rpx;
}
.detail-know {
  margin-top: 22rpx;
  color: #6f4d29;
  font-size: 26rpx;
  line-height: 1.75;
  font-weight: 600;
}
.detail-divider {
  width: 58rpx;
  height: 3rpx;
  margin: 22rpx 0;
  background: rgba(163, 58, 43, 0.45);
}
.detail-body {
  color: #504434;
  font-size: 25rpx;
  line-height: 1.9;
  text-align: justify;
}

.poem {
  margin-top: 22rpx;
  padding: 20rpx 22rpx;
  border-left: 3rpx solid rgba(163, 58, 43, 0.28);
  border-radius: 0 10rpx 10rpx 0;
  background: rgba(163, 58, 43, 0.045);
}
.poem-title {
  text-align: center;
  color: #4a3520;
  font-size: 29rpx;
  font-family: 'STKaiti', 'KaiTi', serif;
}
.poem-author {
  margin-top: 2rpx;
  text-align: center;
  color: #9d8972;
  font-size: 20rpx;
}
.poem-lines { margin-top: 14rpx; }
.poem-line {
  color: #5c4b39;
  text-align: center;
  font-size: 24rpx;
  line-height: 1.85;
  font-family: 'STKaiti', 'KaiTi', serif;
}
.poem-line.hi { color: #a33a2b; }
.poem-insight {
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid rgba(139, 90, 43, 0.16);
  color: #806b54;
  font-size: 22rpx;
  line-height: 1.7;
}

.detail-links { margin-top: 24rpx; }
.detail-links-title {
  color: #9b6a32;
  font-size: 21rpx;
  letter-spacing: 3rpx;
}
.detail-link-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 10rpx;
}
.detail-link {
  padding: 5rpx 12rpx;
  border-radius: 18rpx;
  color: #826b50;
  background: #f0e6d5;
  font-size: 20rpx;
}

.detail-actions {
  display: flex;
  gap: 18rpx;
  margin-top: 28rpx;
}
.detail-btn {
  flex: 1;
  padding: 15rpx 0;
  border-radius: 30rpx;
  color: #8b5a2b;
  border: 1rpx solid rgba(139, 90, 43, 0.4);
  text-align: center;
  font-size: 25rpx;
}
.detail-btn.main {
  color: #fffaf0;
  background: linear-gradient(135deg, #8b5a2b, #a9743c);
  border: none;
}
.detail-btn.disabled { opacity: 0.5; }
.detail-close {
  margin-top: 16rpx;
  padding: 15rpx 0;
  border-radius: 30rpx;
  color: #fffaf0;
  background: linear-gradient(135deg, #8b5a2b, #a9743c);
  text-align: center;
  font-size: 25rpx;
}

.export-canvas {
  position: fixed;
  left: -9999rpx;
  top: 0;
  pointer-events: none;
}
