/* pages/poem/poem.wxss —— 我的诗笺（竖版宣纸 · 朱印 · 暖棕古风） */

.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #3b2d1c 0%, #5a4230 360rpx, #f5f0e8 660rpx, #efe7d8 100%);
  padding-bottom: 80rpx;
}

/* ============ 顶部 ============ */
.poem-head {
  padding: 60rpx 40rpx 34rpx;
  text-align: center;
}
.head-title {
  font-size: 54rpx;
  color: #f0e6d2;
  font-family: 'STKaiti', 'KaiTi', serif;
  letter-spacing: 10rpx;
}
.head-sub {
  margin-top: 14rpx;
  font-size: 25rpx;
  color: rgba(240, 230, 210, 0.66);
  letter-spacing: 3rpx;
}

/* ============ 空态 ============ */
.empty {
  padding: 20rpx 40rpx 0;
}
.empty-paper {
  position: relative;
  padding: 70rpx 44rpx 56rpx;
  border-radius: 16rpx;
  background: linear-gradient(180deg, #faf5e9 0%, #f2e9d7 100%);
  border: 3rpx solid #e0d2b6;
  box-shadow: 0 8rpx 26rpx rgba(59, 45, 28, 0.3);
  text-align: center;
}
.empty-seal {
  position: absolute;
  top: 22rpx;
  right: 22rpx;
  width: 54rpx;
  height: 54rpx;
  line-height: 54rpx;
  text-align: center;
  border-radius: 8rpx;
  background: rgba(158, 42, 43, 0.9);
  color: #f5e9d5;
  font-size: 30rpx;
  font-family: 'STKaiti', 'KaiTi', serif;
}
.empty-title {
  font-size: 52rpx;
  color: #4a3220;
  font-family: 'STKaiti', 'KaiTi', serif;
  letter-spacing: 10rpx;
}
.empty-line {
  width: 120rpx;
  height: 3rpx;
  margin: 22rpx auto;
  background: linear-gradient(90deg, rgba(158, 42, 43, 0), rgba(158, 42, 43, 0.55), rgba(158, 42, 43, 0));
}
.empty-sub {
  font-size: 30rpx;
  color: #7a6446;
  font-family: 'STKaiti', 'KaiTi', serif;
  letter-spacing: 4rpx;
}
.empty-hint {
  margin-top: 26rpx;
  font-size: 23rpx;
  line-height: 1.9;
  color: #a08c6b;
}
.empty-btn {
  margin: 44rpx auto 0;
  padding: 20rpx 0;
  width: 74%;
  border-radius: 44rpx;
  color: #fff;
  font-size: 28rpx;
  letter-spacing: 2rpx;
  background: linear-gradient(135deg, #8b5a2b, #a9743c);
  box-shadow: 0 6rpx 18rpx rgba(139, 90, 43, 0.3);
}
.empty-btn:active { opacity: 0.86; }
.empty-btn.ghost {
  margin-top: 22rpx;
  color: #8b5a2b;
  background: transparent;
  border: 2rpx solid #ded0b6;
  box-shadow: none;
}

/* ============ 诗笺卡 ============ */
.poem-card {
  margin: 30rpx 28rpx 0;
  border-radius: 18rpx;
}
.poem-card.hl .pc-paper {
  border-color: #b07b3e;
  box-shadow: 0 0 0 4rpx rgba(176, 123, 62, 0.28), 0 10rpx 28rpx rgba(139, 90, 43, 0.3);
}

/* 竖版宣纸 */
.pc-paper {
  position: relative;
  padding: 44rpx 36rpx 40rpx;
  border-radius: 16rpx;
  background: linear-gradient(180deg, #faf5e9 0%, #f2e9d7 100%);
  border: 3rpx solid #e0d2b6;
  box-shadow: 0 8rpx 26rpx rgba(59, 45, 28, 0.26);
  overflow: hidden;
}
/* 竖向笺纸格线 */
.pc-rules {
  position: absolute;
  left: 36rpx;
  right: 36rpx;
  top: 30rpx;
  bottom: 30rpx;
  background-image: linear-gradient(90deg, rgba(139, 90, 43, 0.11) 1rpx, transparent 1rpx);
  background-size: 14.28% 100%;
  pointer-events: none;
}
.pc-seal {
  position: absolute;
  top: 26rpx;
  right: 26rpx;
  z-index: 2;
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  border-radius: 8rpx;
  background: rgba(158, 42, 43, 0.92);
  color: #f5e9d5;
  font-size: 30rpx;
  font-family: 'STKaiti', 'KaiTi', serif;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.22);
}
.pc-brand {
  font-size: 21rpx;
  color: #a08c6b;
  letter-spacing: 3rpx;
}
.pc-title {
  margin-top: 8rpx;
  font-size: 46rpx;
  color: #4a3220;
  font-family: 'STKaiti', 'KaiTi', serif;
  letter-spacing: 8rpx;
}
.pc-nick {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: #7a4a1c;
  font-family: 'STKaiti', 'KaiTi', serif;
  letter-spacing: 3rpx;
}
.pc-nick-line {
  width: 110rpx;
  height: 3rpx;
  margin-top: 8rpx;
  background: rgba(158, 42, 43, 0.5);
}

.pc-hr {
  height: 1rpx;
  margin: 26rpx 0 22rpx;
  background: linear-gradient(90deg, rgba(139, 90, 43, 0.35), rgba(139, 90, 43, 0.05));
}

.pc-chapter {
  font-size: 34rpx;
  color: #4a3220;
  font-family: 'STKaiti', 'KaiTi', serif;
  letter-spacing: 3rpx;
}
.pc-meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #9a7d54;
  letter-spacing: 1rpx;
}

/* 正文：左文字 + 右竖排诗句 */
.pc-body {
  margin-top: 24rpx;
  display: flex;
  align-items: flex-start;
}
.pc-left {
  flex: 1;
  min-width: 0;
}
.pc-poem {
  flex-shrink: 0;
  display: flex;
  flex-direction: row-reverse;
  padding-left: 16rpx;
  border-left: 1rpx dashed rgba(139, 90, 43, 0.25);
}
.pc-poem-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 42rpx;
}
.pc-poem-char {
  font-size: 30rpx;
  line-height: 40rpx;
  color: #7a4a1c;
  font-family: 'STKaiti', 'KaiTi', serif;
}

.pc-sec + .pc-sec { margin-top: 22rpx; }
.pc-sec-label {
  font-size: 22rpx;
  color: #8b5a2b;
  letter-spacing: 2rpx;
  margin-bottom: 10rpx;
}
.pc-choice {
  font-size: 25rpx;
  line-height: 1.65;
  color: #4a3a28;
}
.pc-choice.on { color: #7a4a1c; font-weight: 600; }
.pc-choice.off { color: #4a3a28; }
.pc-anchors {
  font-size: 24rpx;
  line-height: 1.75;
  color: #4a3a28;
  font-family: 'STKaiti', 'KaiTi', serif;
}
.pc-stat {
  font-size: 23rpx;
  line-height: 1.7;
  color: #6b8e5a;
}

.pc-verdict {
  font-size: 25rpx;
  color: #8b5a2b;
  font-family: 'STKaiti', 'KaiTi', serif;
  letter-spacing: 2rpx;
}
.pc-foot {
  font-size: 21rpx;
  color: #a08c6b;
  letter-spacing: 2rpx;
  text-align: right;
}

/* 操作按钮 */
.pc-actions {
  margin-top: 22rpx;
  display: flex;
}
.pc-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 44rpx;
  font-size: 27rpx;
  color: #8b5a2b;
  background: #fffdf7;
  border: 2rpx solid #e2d5bd;
}
.pc-btn:active { opacity: 0.8; }
.pc-btn.main {
  margin-right: 20rpx;
  color: #fff;
  border-color: transparent;
  background: linear-gradient(135deg, #8b5a2b, #a9743c);
  box-shadow: 0 6rpx 16rpx rgba(139, 90, 43, 0.26);
}
.pc-btn.disabled { opacity: 0.6; }
.pc-tip {
  margin-top: 14rpx;
  font-size: 21rpx;
  color: #b5a892;
  line-height: 1.6;
  text-align: center;
}

.list-foot {
  margin-top: 50rpx;
  text-align: center;
  font-size: 22rpx;
  color: #b5a892;
  letter-spacing: 2rpx;
}

/* 离屏导出画布：移出可视区，不参与页面视觉 */
.export-canvas {
  position: fixed;
  left: -2000px;
  top: 0;
  z-index: -1;
}
