<!-- pages/poem/poem.wxml —— 我的诗笺（每通关一期生成一张竖版诗笺卡，可存图、可分享） -->

<view class="page">

  <view class="poem-head">
    <view class="head-title">我的诗笺</view>
    <view class="head-sub">你走过的每一程，都值得留下一张笺</view>
  </view>

  <!-- ===== 空态 ===== -->
  <view wx:if="{{isEmpty}}" class="empty">
    <view class="empty-paper">
      <view class="empty-seal">笺</view>
      <view class="empty-title">诗笺待书</view>
      <view class="empty-line"></view>
      <view class="empty-sub">先随先生走一程吧</view>
      <view class="empty-hint">通关任一时期，这里就会为你落下一张诗笺——<br />你的抉择、你点亮的锚点、你抓出的史实错漏，都在上面。</view>
      <view class="empty-btn" bindtap="goStory">去看看剧本 ›</view>
      <view class="empty-btn ghost" bindtap="goMap">先看行迹地图 ›</view>
    </view>
  </view>

  <!-- ===== 诗笺卡列表（按通关时间倒序） ===== -->
  <block wx:else>
    <view
      wx:for="{{cards}}"
      wx:key="key"
      class="poem-card {{item.highlight ? 'hl' : ''}}"
      id="card-{{item.key}}"
    >
      <!-- 竖版宣纸 -->
      <view class="pc-paper">
        <view class="pc-rules"></view>
        <view class="pc-seal">笺</view>

        <view class="pc-brand">寻迹 · 古今</view>
        <view class="pc-title">我 的 诗 笺</view>
        <view class="pc-nick">{{item.nickname}}</view>
        <view class="pc-nick-line"></view>

        <view class="pc-hr"></view>

        <view class="pc-chapter">第{{item.indexChar}}程 · {{item.periodName}}</view>
        <view class="pc-meta">{{item.lineName}} · {{item.range}} · {{item.dateText}}</view>

        <view class="pc-body">
          <view class="pc-left">
            <view class="pc-sec" wx:if="{{item.hasChoices}}">
              <view class="pc-sec-label">我在此间的抉择</view>
              <view class="pc-choice {{c.cls}}" wx:for="{{item.choices}}" wx:for-item="c" wx:key="text">{{c.label}}{{c.text}}</view>
            </view>

            <view class="pc-sec" wx:if="{{item.anchorNames.length}}">
              <view class="pc-sec-label">点亮的锚点 · {{item.anchorLit}}/{{item.anchorTotal}}</view>
              <view class="pc-anchors">{{item.anchorText}}</view>
            </view>

            <view class="pc-sec" wx:if="{{item.hasTrap || item.hasQuiz}}">
              <view class="pc-sec-label">探究战绩</view>
              <view class="pc-stat" wx:if="{{item.hasTrap}}">考据之眼 · 抓出 {{item.trapCaught}}/{{item.trapTotal}} 处史实错漏</view>
              <view class="pc-stat" wx:if="{{item.hasQuiz}}">先生考校 · 答对 {{item.quizCorrect}}/{{item.quizTotal}} 题</view>
            </view>
          </view>

          <view class="pc-poem" wx:if="{{item.poem}}">
            <view class="pc-poem-col" wx:for="{{item.poemCols}}" wx:for-item="col" wx:key="k">
              <text class="pc-poem-char" wx:for="{{col.cells}}" wx:for-item="cell" wx:key="k">{{cell.ch}}</text>
            </view>
          </view>
        </view>

        <view class="pc-hr" wx:if="{{item.hasVerdict}}"></view>
        <view class="pc-verdict" wx:if="{{item.hasVerdict}}">{{item.verdict}}</view>

        <view class="pc-hr"></view>
        <view class="pc-foot">循一卷诗书，赴一场千年之约</view>
      </view>

      <!-- 操作 -->
      <view class="pc-actions">
        <view class="pc-btn main {{exporting ? 'disabled' : ''}}" bindtap="onExport" data-key="{{item.key}}">保存为图片</view>
        <view class="pc-btn" bindtap="onCopy" data-key="{{item.key}}">复制文案</view>
      </view>
      <view class="pc-tip">「保存为图片」会生成一张竖版诗笺图，可直接分享；也可长按本页截图保存。</view>
    </view>

    <view class="list-foot">循着走过的路，慢慢攒成一部你的诗笺集</view>
  </block>

  <!-- 离屏导出画布（不参与视觉布局；导出时逐笔重绘诗笺版式） -->
  <canvas type="2d" id="poemCanvas" class="export-canvas" style="width: {{cw}}px; height: {{ch}}px;"></canvas>
</view>
