<!-- pages/poem/poem.wxml —— 我的诗笺（记录游玩过程中点亮的知识印谱） -->

<view class="page">

  <!-- 诗人分册 tab -->
  <view class="line-tabs">
    <view
      wx:for="{{lineTabs}}"
      wx:key="id"
      class="line-tab {{item.id === currentLineId ? 'on' : ''}}"
      bindtap="onSwitchLine"
      data-id="{{item.id}}"
    >
      <view class="line-tab-name">{{item.name}}</view>
      <view class="line-tab-count">{{item.collected}} / {{item.total}}</view>
    </view>
  </view>

  <!-- 印谱正文：按时期分组，每个锚点一枚印记 -->
  <view class="book-body" wx:if="{{collected}}">
    <view class="period" wx:for="{{groups}}" wx:key="id">
      <view class="period-head">
        <text class="period-name">{{item.name}}</text>
        <text class="period-range" wx:if="{{item.range}}">{{item.range}}</text>
      </view>
      <view
        class="imprint"
        wx:for="{{item.cards}}"
        wx:for-item="card"
        wx:key="id"
        bindtap="onOpenAnchor"
        data-id="{{card.id}}"
      >
        <view class="imprint-seal">{{card.seal}}</view>
        <view class="imprint-main">
          <view class="imprint-title-row">
            <text class="imprint-title">{{card.name}}</text>
            <text class="poem-tag" wx:if="{{card.hasPoem}}">含诗文</text>
          </view>
          <view class="imprint-know">{{card.know}}</view>

          <!-- 诗句：挂了 poem 的印记，横排呈现（highlight 句标朱砂） -->
          <view class="imprint-poem" wx:if="{{card.hasPoem}}">
            <view class="ip-poem-title">《{{card.poem.title}}》{{card.poem.author}}{{card.poem.displayMode === 'excerpt' ? '（节选）' : ''}}</view>
            <view class="ip-poem-lines">
              <!-- wx:for-item="line"：默认循环变量是 item，而这里用的是 line.*。
                   缺这一行会导致诗句渲染为空白（check-wxml-data 一直报 poem.wxml→line）。 -->
              <view
                class="ip-poem-line {{line.highlight ? 'hi' : ''}}"
                wx:for="{{card.poem.lines}}"
                wx:for-item="line"
                wx:key="text"
              >{{line.text}}</view>
            </view>
          </view>
        </view>
        <view class="imprint-arrow">›</view>
      </view>
    </view>
  </view>

  <!-- 空态 -->
  <view class="empty" wx:else>
    <view class="empty-seal">识</view>
    <view class="empty-title">诗笺尚空</view>
    <view class="empty-text">在人物旅程中发现知识，点亮的印记会安静地收在这里。</view>
    <view class="empty-btn" bindtap="goStory">去看看剧本 ›</view>
  </view>

  <!-- 完整史料弹窗 -->
  <view class="detail-mask" wx:if="{{selectedAnchor}}" bindtap="onCloseAnchor">
    <scroll-view class="detail-card" scroll-y="true" catchtap="noop">
      <view class="detail-seal">{{selectedAnchor.seal}}</view>
      <view class="detail-name">{{selectedAnchor.name}}</view>

      <view class="poem {{selectedAnchor.poem.displayMode === 'excerpt' ? 'excerpt' : ''}}" wx:if="{{selectedAnchor.poem}}">
        <view class="poem-title">《{{selectedAnchor.poem.title}}》</view>
        <view class="poem-author">{{selectedAnchor.poem.author}}{{selectedAnchor.poem.displayMode === 'excerpt' ? ' · 节选' : ''}}</view>
        <view class="poem-lines">
          <view
            class="poem-line {{item.highlight ? 'hi' : ''}}"
            wx:for="{{selectedAnchor.poem.lines}}"
            wx:key="text"
          >{{item.text}}</view>
        </view>
        <view class="poem-insight" wx:if="{{selectedAnchor.poem.insight}}">{{selectedAnchor.poem.insight}}</view>
      </view>

      <view class="detail-know">{{selectedAnchor.know}}</view>
      <view class="detail-divider"></view>
      <view class="detail-body">{{selectedAnchor.detail}}</view>
      <view class="detail-links" wx:if="{{selectedAnchor.links.length}}">
        <view class="detail-links-title">关联</view>
        <view class="detail-link-list">
          <text class="detail-link" wx:for="{{selectedAnchor.links}}" wx:key="*this">{{item}}</text>
        </view>
      </view>

      <view class="detail-actions">
        <view class="detail-btn" catchtap="onCopy" data-id="{{selectedAnchor.id}}">复制文案</view>
        <view class="detail-btn main {{exporting ? 'disabled' : ''}}" catchtap="onExport" data-id="{{selectedAnchor.id}}">保存为图片</view>
      </view>
      <view class="detail-close" catchtap="onCloseAnchor">收起</view>
    </scroll-view>
  </view>

  <!-- 离屏导出画布 -->
  <canvas type="2d" id="poemCanvas" class="export-canvas" style="width: {{cw}}px; height: {{ch}}px;"></canvas>

  <!-- 微信官方隐私授权弹窗 -->
  <privacy-popup />
</view>
