/* pages/map/map.wxss —— 行迹地图（水墨舆图 · 暖棕古风） */

.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #3b2d1c 0%, #5a4230 420rpx, #f5f0e8 720rpx, #efe7d8 100%);
  padding-bottom: 60rpx;
}

/* ============ 顶部 ============ */
.map-head {
  padding: 56rpx 32rpx 28rpx;
}
.head-title {
  font-size: 52rpx;
  color: #f0e6d2;
  font-family: 'STKaiti', 'KaiTi', serif;
  letter-spacing: 8rpx;
}
.head-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: rgba(240, 230, 210, 0.62);
  letter-spacing: 2rpx;
}
/* 切换条 */
.line-tabs {
  margin-top: 30rpx;
  display: flex;
}
.tab {
  padding: 14rpx 40rpx;
  margin-right: 20rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  color: rgba(240, 230, 210, 0.7);
  background: rgba(240, 230, 210, 0.08);
  border: 2rpx solid rgba(240, 230, 210, 0.18);
  font-family: 'STKaiti', 'KaiTi', serif;
  letter-spacing: 3rpx;
  transition: all 0.2s ease;
}
.tab.on {
  color: #3b2d1c;
  background: linear-gradient(135deg, #f0e6d2, #d9c7a3);
  border-color: transparent;
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.22);
}

/* 当前旅程：进入当前可玩剧情的统一入口 */
.current-journey {
  margin-top: 26rpx;
  padding: 22rpx 24rpx;
  display: flex;
  align-items: center;
  border: 2rpx solid rgba(240, 230, 210, 0.30);
  border-radius: 16rpx;
  background: rgba(240, 230, 210, 0.10);
}
.current-journey:active { opacity: 0.82; }
.current-seal {
  flex-shrink: 0;
  width: 58rpx;
  height: 58rpx;
  line-height: 58rpx;
  text-align: center;
  border-radius: 8rpx;
  background: #9e2a2b;
  color: #f5e9d5;
  font-size: 30rpx;
  font-family: 'STKaiti', 'KaiTi', serif;
}
.current-body {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}
.current-label {
  font-size: 21rpx;
  color: rgba(240, 230, 210, 0.62);
  letter-spacing: 3rpx;
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 14rpx;
}
/* 同行者：与「当前行迹」同一行、右移一点，用淡金区分，不抢主标题 */
.current-companion {
  color: rgba(226, 205, 156, 0.86);
  letter-spacing: 1rpx;
}
.current-title {
  margin-top: 4rpx;
  font-size: 31rpx;
  color: #f0e6d2;
  font-family: 'STKaiti', 'KaiTi', serif;
  letter-spacing: 2rpx;
}
.current-meta,
.current-route {
  margin-top: 5rpx;
  font-size: 21rpx;
  color: rgba(240, 230, 210, 0.64);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.current-action {
  flex-shrink: 0;
  margin-left: 18rpx;
  font-size: 24rpx;
  color: #f0d5a3;
  font-family: 'STKaiti', 'KaiTi', serif;
}
.journey-done { background: rgba(107, 142, 90, 0.14); }
.journey-done:active { opacity: 1; }
.journey-done .current-seal { background: #6b8e5a; }

/* 进度总览 */
.progress-wrap {
  margin-top: 26rpx;
}
.progress-bar {
  flex: 1;
  height: 12rpx;
  background: rgba(240, 230, 210, 0.22);
  border-radius: 6rpx;
  overflow: hidden;
}
.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #d9b06a 0%, #b07b3e 100%);
  border-radius: 6rpx;
  transition: width 0.5s ease;
}
.progress-text {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: rgba(240, 230, 210, 0.85);
  letter-spacing: 1rpx;
  text-align: right;
}

/* ============ 地图（纸面） ============ */
.map-wrap {
  position: relative;
  margin: 0 24rpx;
  padding: 14rpx;
  background: linear-gradient(180deg, #f8f2e3 0%, #f3ebd8 100%);
  border: 3rpx solid #e0d2b6;
  border-radius: 18rpx;
  box-shadow: 0 8rpx 24rpx rgba(59, 45, 28, 0.28);
}

/* 缩放控制：叠在地图右上角（缩放/平移后出现，含倍率提示 + 复位按钮） */
.map-zoom {
  position: absolute;
  top: 26rpx;
  right: 26rpx;
  z-index: 10;
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.map-zoom-tip {
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 21rpx;
  color: #f0e6d2;
  background: rgba(59, 45, 28, 0.62);
  letter-spacing: 1rpx;
}
.map-zoom-reset {
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  font-size: 21rpx;
  color: #4a3220;
  background: #f0e6d2;
  border: 2rpx solid #d8c6a7;
  letter-spacing: 1rpx;
}
.map-zoom-reset:active { opacity: 0.75; }

.map-stage {
  position: relative;
  width: 100%;
  overflow: hidden;
  border-radius: 10rpx;
  background: #f7f1e2;
  /* 未缩放时允许页面纵向滚动（pan-y），缩放后禁止（none）交地图平移。
     配合 JS 里「未缩放不平移」的判断，解决地图拖动与页面滚动冲突。 */
  touch-action: pan-y;
}
.map-stage.zoom-status,
.map-stage.zoom-detail,
.map-stage.zoom-poem {
  touch-action: none;
}
/* 可缩放内层：只做平移（translate 不产生位图模糊）。缩放由 JS 布局级完成：
   地点/路线的 left/top 在 JS 重算、原生渲染（文字/线条矢量清晰）；
   底图位图单独 transform scale（位图放大有固有柔化，属正常）。 */
.map-inner {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  transform-origin: 0px 0px;
  will-change: transform;
}
/* 底图/疆界层/降级层：位图缩放以左上角为原点（与 JS 布局坐标一致） */
.map-bg,
.map-boundary,
.map-fallback {
  transform-origin: 0px 0px;
}
/* 聚焦/复位动画期间：临时开启 left/top/width 与底图 transform 的过渡，
   动画结束（mapAnim 复位 none、anim 类移除）后关闭，避免手势拖动抖动/滞后。 */
.map-inner.anim .map-bg,
.map-inner.anim .map-boundary,
.map-inner.anim .map-fallback {
  transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1),
    opacity 0.25s ease, filter 0.25s ease;
}
.map-inner.anim .wp,
.map-inner.anim .wp-origin,
.map-inner.anim .seg,
.map-inner.anim .seg-arrow {
  transition: left 0.5s cubic-bezier(0.22, 1, 0.36, 1),
    top 0.5s cubic-bezier(0.22, 1, 0.36, 1),
    width 0.5s cubic-bezier(0.22, 1, 0.36, 1);
}
.map-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  opacity: 0.92;
  filter: saturate(0.9) contrast(1.05) brightness(1.0);
  transition: opacity 0.25s ease, filter 0.25s ease;
  /* 高度由内联 style 注入 mapH，底部留安全区给标签 */
}
.map-bg-status {
  opacity: 0.94;
  filter: saturate(0.94) contrast(1.06) brightness(1.0);
}
.map-bg-detail,
.map-bg-poem {
  opacity: 0.96;
  filter: saturate(0.96) contrast(1.07) brightness(1.0);
}
.map-boundary {
  position: absolute;
  left: 0;
  top: 0;
  z-index: 1;
  width: 100%;
  pointer-events: none;
}

/* 朝代说明固定在地图视窗左上角：首屏只显示断代，放大后补充考据口径。 */
.map-era {
  position: absolute;
  left: 16rpx;
  top: 16rpx;
  z-index: 8;
  max-width: 250rpx;
  padding: 8rpx 12rpx;
  border: 1rpx solid rgba(112, 81, 47, 0.2);
  border-radius: 6rpx;
  background: rgba(248, 242, 227, 0.78);
  box-shadow: 0 2rpx 8rpx rgba(59, 45, 28, 0.08);
  pointer-events: none;
}
.map-era-title {
  color: #6d5235;
  font-size: 19rpx;
  line-height: 1.2;
  font-family: 'STKaiti', 'KaiTi', serif;
  letter-spacing: 2rpx;
}
.map-era-note {
  margin-top: 4rpx;
  color: rgba(109, 82, 53, 0.68);
  font-size: 15rpx;
  line-height: 1.35;
  letter-spacing: 1rpx;
}

/* -------- 降级层：纯 CSS 水墨示意 -------- */
.map-fallback {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  overflow: hidden;
  /* 高度由内联 style 注入 mapH */
  background:
    radial-gradient(ellipse 46% 26% at 26% 14%, rgba(90, 66, 48, 0.20), rgba(90, 66, 48, 0) 72%),
    radial-gradient(ellipse 40% 24% at 20% 30%, rgba(90, 66, 48, 0.15), rgba(90, 66, 48, 0) 72%),
    radial-gradient(ellipse 34% 20% at 34% 66%, rgba(90, 66, 48, 0.13), rgba(90, 66, 48, 0) 74%),
    radial-gradient(ellipse 30% 18% at 14% 82%, rgba(90, 66, 48, 0.12), rgba(90, 66, 48, 0) 74%),
    radial-gradient(ellipse 50% 30% at 88% 12%, rgba(78, 104, 122, 0.10), rgba(78, 104, 122, 0) 76%),
    linear-gradient(158deg, #f9f4e6 0%, #f4ecda 58%, #ede2cc 100%);
}
.fb-grid {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  opacity: 0.55;
  background-image:
    linear-gradient(rgba(139, 90, 43, 0.07) 1rpx, transparent 1rpx),
    linear-gradient(90deg, rgba(139, 90, 43, 0.07) 1rpx, transparent 1rpx);
  background-size: 12.5% 12.5%;
}
.fb-blob {
  position: absolute;
  border-radius: 50%;
  filter: blur(10rpx);
}
.fb-blob.b1 {
  left: 6%;
  top: 4%;
  width: 46%;
  height: 22%;
  background: radial-gradient(ellipse at 40% 60%, rgba(74, 54, 38, 0.22), rgba(74, 54, 38, 0) 72%);
  transform: rotate(-12deg);
}
.fb-blob.b2 {
  left: 2%;
  top: 24%;
  width: 40%;
  height: 20%;
  background: radial-gradient(ellipse at 50% 50%, rgba(74, 54, 38, 0.16), rgba(74, 54, 38, 0) 72%);
  transform: rotate(8deg);
}
.fb-blob.b3 {
  left: 14%;
  top: 44%;
  width: 34%;
  height: 16%;
  background: radial-gradient(ellipse at 50% 50%, rgba(74, 54, 38, 0.13), rgba(74, 54, 38, 0) 74%);
  transform: rotate(-5deg);
}
.fb-blob.b4 {
  right: 4%;
  top: 8%;
  width: 34%;
  height: 22%;
  background: radial-gradient(ellipse at 50% 50%, rgba(78, 104, 122, 0.12), rgba(78, 104, 122, 0) 74%);
}
/* 江河：用大圆角边框画弧线 */
.fb-river {
  position: absolute;
  border-top: 3rpx solid rgba(78, 104, 122, 0.26);
  border-radius: 50% 50% 0 0 / 100% 100% 0 0;
}
.fb-river.r1 {
  left: 4%;
  top: 34%;
  width: 74%;
  height: 90rpx;
  transform: rotate(-7deg);
}
.fb-river.r2 {
  left: 8%;
  top: 52%;
  width: 82%;
  height: 110rpx;
  border-top-color: rgba(78, 104, 122, 0.32);
  transform: rotate(6deg);
}
.fb-river.r3 {
  left: 30%;
  top: 70%;
  width: 62%;
  height: 80rpx;
  transform: rotate(-10deg);
}
.fb-tip {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 10rpx;
  text-align: center;
  font-size: 20rpx;
  color: rgba(139, 90, 43, 0.45);
  letter-spacing: 2rpx;
}

/* -------- 路线层 -------- */
.route-layer {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  pointer-events: none;
  z-index: 2;
  /* 高度由内联 style 注入 mapH */
}
.seg {
  position: absolute;
  height: 3rpx;
  margin-top: -1.5rpx;
  transform-origin: 0 50%;
  border-radius: 2rpx;
}
/* 已点亮段：墨色渐深、像毛笔带过的一笔；入场先晕开，之后墨迹沿路缓缓流动。
   首屏路线对比度整体压低，让编号地点标签更突出、更易读。 */
.seg-lit {
  background: linear-gradient(90deg,
    rgba(139, 90, 43, 0.38) 0%,
    rgba(176, 123, 62, 0.55) 28%,
    rgba(139, 90, 43, 0.48) 55%,
    rgba(176, 123, 62, 0.36) 100%);
  background-size: 240% 100%;
  box-shadow: 0 0 5rpx rgba(139, 90, 43, 0.28);
  animation:
    inkSpread 0.8s ease-out both,
    inkFlow 3.6s linear infinite;
}
.seg-next {
  background: repeating-linear-gradient(90deg, rgba(176, 123, 62, 0.42) 0, rgba(176, 123, 62, 0.42) 12rpx, transparent 12rpx, transparent 26rpx);
  animation: inkSpread 1s ease-out both, dashFlow 1.4s linear infinite;
}
/* 下一步段：虚线沿方向滚动，形成「往前走」的动态引导 */
@keyframes dashFlow {
  from { background-position: 0 0; }
  to { background-position: 26rpx 0; }
}
.seg-locked {
  background: repeating-linear-gradient(90deg, rgba(160, 140, 107, 0.24) 0, rgba(160, 140, 107, 0.24) 8rpx, transparent 8rpx, transparent 22rpx);
}
@keyframes inkSpread {
  from { opacity: 0; filter: blur(7rpx); }
  to { opacity: 1; filter: blur(0); }
}
/* 墨迹流动：把背景拉宽后平移，深色墨团沿路线从起点滚向终点，循环不息 */
@keyframes inkFlow {
  from { background-position: 0% 0; }
  to { background-position: -240% 0; }
}

/* -------- 方向箭头：贴在路线段终点，指向行进方向 -------- */
.seg-arrow {
  position: absolute;
  width: 0;
  height: 0;
  margin: -5rpx 0 0 -3rpx;      /* 以箭尖为定位锚点，旋转中心对齐 */
  border-top: 5rpx solid transparent;
  border-bottom: 5rpx solid transparent;
  transform-origin: 3rpx 5rpx;  /* 让箭头绕箭尖旋转，与段方向一致 */
}
/* 已走过段：实心金棕箭头 */
.seg-arrow.seg-lit {
  border-left: 11rpx solid rgba(176, 123, 62, 0.85);
  filter: drop-shadow(0 0 2rpx rgba(139, 90, 43, 0.5));
}
/* 下一步段：空心朱砂箭头（与「当前地点」朱砂呼应，提示往哪走） */
.seg-arrow.seg-next {
  border-left: 11rpx solid rgba(158, 42, 43, 0.85);
}
/* 锁定段：浅灰箭头（保留方向指引，但不抢眼、不剧透路线内容） */
.seg-arrow.seg-locked {
  border-left: 11rpx solid rgba(160, 140, 107, 0.5);
}

/* -------- 当前行迹指示：圆形诗人头像 + 竖直向下箭头（替代呼吸圈） -------- */
/* 位于 .wp 锚点（=圆点）内部，位置随 JS 布局级缩放重算，标签原生尺寸渲染不发虚。
   头像浮在圆点正上方，箭头竖直向下指向圆点。 */
.wp-avatar {
  position: absolute;
  left: 0;
  top: 0;
  width: 0;
  height: 0;
  pointer-events: none;
  z-index: 4;
}
.wp-avatar-img {
  position: absolute;
  left: 50%;
  top: 0;                      /* 立绘顶部对齐圆框上缘（浮动动画上移时不裁到头顶） */
  width: 112rpx;               /* 1024x1536 立绘，widthFix 后高约 168rpx，
                                  圆框 64rpx 只露出顶部约 38% = 肩膀以上 */
  transform: translateX(-50%);
  border-radius: 0;            /* 裁剪交给外层 .wp-avatar-clip */
  border: none;
  box-shadow: none;
  background: transparent;
  animation: avatarBob 2.4s ease-in-out infinite;
}
/* 圆形裁剪容器：只露出立绘上半身（肩膀及以上） */
.wp-avatar-clip {
  position: absolute;
  left: 50%;
  bottom: 22rpx;               /* 圆点上方，留出箭头空间 */
  width: 64rpx;
  height: 64rpx;
  transform: translateX(-50%);
  border-radius: 50%;
  overflow: hidden;
  border: 3rpx solid #f8edda;
  box-shadow: 0 2rpx 10rpx rgba(59, 45, 28, 0.35), 0 0 0 2rpx rgba(158, 42, 43, 0.7);
  background: #e8dcc4;
}
/* 竖直向下箭头：从头像底部指向圆点 */
.wp-avatar-arrow {
  position: absolute;
  left: 50%;
  bottom: 2rpx;                /* 箭头尖端贴近圆点 */
  width: 0;
  height: 0;
  transform: translateX(-50%);
  border-left: 8rpx solid transparent;
  border-right: 8rpx solid transparent;
  border-top: 12rpx solid rgba(158, 42, 43, 0.92);
  filter: drop-shadow(0 1rpx 2rpx rgba(59, 45, 28, 0.3));
}
/* 头像轻缓上下浮动，强化「指向当前」的动态引导 */
@keyframes avatarBob {
  0%, 100% { transform: translateX(-50%) translateY(0); }
  50%      { transform: translateX(-50%) translateY(-6rpx); }
}

/* -------- 地点层 -------- */
.wp-layer {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  z-index: 3;
  /* 高度由内联 style 注入 mapH；标签在圆点下方，底部安全区由 stageH 提供 */
}
/* 真实位置小圆点：钉在原坐标，路线端点与它对齐，永不移动 */
.wp-origin {
  position: absolute;
  width: 12rpx;
  height: 12rpx;
  margin: -6rpx 0 0 -6rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 34% 30%, #d5c8b3, #b3a390);
  border: 2rpx solid #9d8c77;
  pointer-events: none;
  z-index: 1;
}
.wp-origin.completed {
  background: radial-gradient(circle at 34% 30%, #cf9243, #8b5a2b);
  border-color: #6b4420;
}
.wp-origin.active {
  background: radial-gradient(circle at 34% 30%, #e0ab4e, #a9662a);
  border-color: #8b5a2b;
  box-shadow: 0 0 10rpx rgba(200, 140, 60, 0.8);
}
.wp-origin.wp-key.completed,
.wp-origin.wp-key.active {
  background: radial-gradient(circle at 34% 30%, #c84b43, #9e2a2b);
  border-color: #7a1f20;
}
/* 标注锚点：零尺寸定位点，子元素环绕；反向缩放由 style 注入 */
.wp {
  position: absolute;
  width: 0;
  height: 0;
  z-index: 2;
}
/* 扩大点击热区（约 60–72rpx 见方，随反向缩放后仍保持可点） */
.wp-hit {
  position: absolute;
  left: -34rpx;
  top: -8rpx;
  width: 68rpx;
  height: 56rpx;
}
/* ===== 固定组合标签：编号（状态色）+ 地名（宣纸底），横向排列 =====
   永远位于圆点正下方、以圆点为中心水平居中；与圆点保持约 8rpx 固定间距。 */
.wp-chip {
  position: absolute;
  left: 0;
  top: 8rpx;                       /* 圆点正下方，固定间距 8rpx（圆点半高 6rpx + 8rpx） */
  transform: translateX(-50%);     /* 只水平居中，不垂直偏移 */
  display: flex;
  align-items: center;
  height: 30rpx;                   /* 缩小高度，缓解密集区重叠 */
  border-radius: 7rpx;
  overflow: hidden;
  background: rgba(248, 242, 227, 0.86);   /* 半透明宣纸底（提高不透明度，压住路线） */
  box-shadow: 0 1rpx 4rpx rgba(59, 45, 28, 0.16);
  white-space: nowrap;
  pointer-events: none;            /* 命中交给 .wp-hit */
}
/* 编号单元：状态色块（统一两位编号，min-width 固定，保证对齐紧凑） */
.wp-chip-seq {
  flex-shrink: 0;
  min-width: 24rpx;
  height: 30rpx;
  line-height: 30rpx;
  padding: 0 4rpx;
  box-sizing: border-box;
  text-align: center;
  font-size: 17rpx;
  color: #f5e9d5;
  font-family: 'STKaiti', 'KaiTi', serif;
  background: rgba(160, 140, 107, 0.92);    /* 默认/锁定：灰 */
}
/* 状态色：已完成 = 金棕，当前 = 朱砂 */
.wp.completed .wp-chip-seq { background: rgba(176, 123, 62, 0.95); }
.wp.active .wp-chip-seq { background: rgba(158, 42, 43, 0.92); }
.wp.wp-key .wp-chip-seq { background: rgba(158, 42, 43, 0.92); }
/* 多次到访：编号并列，中间用细分割（同一行，不重复地名） */
.wp-chip-seq + .wp-chip-seq {
  border-left: 1rpx solid rgba(255, 255, 255, 0.35);
}
/* 地名：宣纸底上一行文字 */
.wp-chip-name {
  flex-shrink: 0;
  padding: 0 8rpx 0 6rpx;
  line-height: 30rpx;
  font-size: 18rpx;
  color: #4a3a28;
  font-family: 'STKaiti', 'KaiTi', serif;
  letter-spacing: 0;
  white-space: nowrap;
}
/* 锁定地点：降低整体透明度（首屏仍显示编号与地名） */
.wp.locked .wp-chip {
  opacity: 0.5;
}
.wp.locked .wp-chip-name { color: #8a7a66; }
/* 当前地点：细描边 + 轻微光晕，不叠「行」字印章 */
.wp-current .wp-chip {
  border: 2rpx solid #a9662a;
  box-shadow: 0 0 10rpx rgba(200, 140, 60, 0.7), 0 1rpx 4rpx rgba(59, 45, 28, 0.16);
}

/* 图例 */
.legend {
  display: flex;
  justify-content: center;
  padding: 18rpx 0 4rpx;
}
.legend-item {
  display: flex;
  align-items: center;
  margin: 0 18rpx;
  font-size: 22rpx;
  color: #8c7b6b;
}
.legend-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 8rpx;
}
.legend-dot.done { background: linear-gradient(135deg, #cf9243, #8b5a2b); }
.legend-dot.now { background: linear-gradient(135deg, #e0ab4e, #a9662a); box-shadow: 0 0 8rpx rgba(200, 140, 60, 0.8); }
.legend-dot.lock { background: #c2b5a2; }

.map-caption {
  padding: 12rpx 12rpx 6rpx;
  font-size: 23rpx;
  line-height: 1.7;
  color: #7a6446;
  font-family: 'STKaiti', 'KaiTi', serif;
  letter-spacing: 1rpx;
  text-align: center;
}

/* ============ 地点卡片 ============ */
.card-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  background: rgba(40, 28, 16, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 48rpx;
}
.wp-card {
  position: relative;
  width: 100%;
  max-width: 620rpx;
  max-height: 84vh;
  overflow: hidden;
  border-radius: 16rpx;
  background: linear-gradient(180deg, #f8f2e3 0%, #f3ebd8 100%);
  border: 3rpx solid #e0d2b6;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.45);
  animation: cardIn 0.22s ease-out both;
}
@keyframes cardIn {
  from { opacity: 0; transform: translateY(24rpx) scale(0.97); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}
.wp-card-seal {
  position: absolute;
  top: 18rpx;
  right: 18rpx;
  z-index: 2;
  width: 54rpx;
  height: 54rpx;
  line-height: 54rpx;
  text-align: center;
  border-radius: 8rpx;
  background: rgba(158, 42, 43, 0.9);
  color: #f5e9d5;
  font-size: 30rpx;
  font-family: 'STKaiti', 'KaiTi', serif;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.25);
}
.wp-card-scene {
  height: 230rpx;
  overflow: hidden;
}
.wp-card-img {
  width: 100%;
  height: 100%;
}
.img-locked { filter: grayscale(0.9) brightness(0.85); }

.wp-card-body {
  padding: 26rpx 30rpx 30rpx;
}
.wp-card-name {
  font-size: 42rpx;
  color: #4a3220;
  font-family: 'STKaiti', 'KaiTi', serif;
  letter-spacing: 4rpx;
}
.wp-card-sub {
  font-size: 26rpx;
  color: #9e2a2b;
  letter-spacing: 1rpx;
}
.wp-card-meta {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #9a7d54;
  letter-spacing: 1rpx;
}
.wp-card-state {
  display: inline-block;
  margin-top: 14rpx;
  padding: 4rpx 18rpx;
  border-radius: 24rpx;
  font-size: 21rpx;
  color: #fff;
}
.wp-card-state.completed { background: rgba(107, 142, 90, 0.92); }
.wp-card-state.active { background: rgba(176, 123, 62, 0.92); }
.wp-card-state.locked { background: rgba(160, 140, 107, 0.85); }
/* 关键地点：状态徽章与名称点缀朱砂红 */
.wp-card-state.wp-key-state.completed { background: rgba(158, 42, 43, 0.92); }
.wp-card-state.wp-key-state.active { background: rgba(158, 42, 43, 0.92); }

.wp-card-note {
  margin-top: 18rpx;
  font-size: 26rpx;
  line-height: 1.72;
  color: #4a3a28;
}
.wp-card-poem {
  margin-top: 20rpx;
  padding: 18rpx 20rpx;
  border-left: 5rpx solid #b07b3e;
  background: rgba(176, 123, 62, 0.09);
  border-radius: 0 10rpx 10rpx 0;
}
.poem-text {
  display: block;
  font-size: 29rpx;
  color: #7a4a1c;
  font-family: 'STKaiti', 'KaiTi', serif;
  letter-spacing: 2rpx;
  line-height: 1.6;
}
.poem-src {
  display: block;
  margin-top: 8rpx;
  font-size: 21rpx;
  color: #a08c6b;
  text-align: right;
}
.wp-card-anchor {
  margin-top: 16rpx;
  font-size: 23rpx;
  color: #6b8e5a;
  letter-spacing: 1rpx;
}

.wp-card-actions {
  margin-top: 26rpx;
  display: flex;
  align-items: center;
}
.act {
  padding: 16rpx 30rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
}
.act-main {
  flex: 1;
  text-align: center;
  color: #fff;
  background: linear-gradient(135deg, #8b5a2b, #a9743c);
  box-shadow: 0 4rpx 14rpx rgba(139, 90, 43, 0.28);
}
.act-main:active { opacity: 0.85; }
.act-ghost {
  margin-left: 18rpx;
  color: #8c7b6b;
  border: 2rpx solid #ded0b6;
  background: transparent;
}
.act-ghost:active { opacity: 0.7; }

/* ============ 同城行迹卡 ============ */
.city-list {
  margin-top: 22rpx;
}
.city-item {
  display: flex;
  align-items: center;
  padding: 20rpx 4rpx;
  border-top: 2rpx solid rgba(139, 90, 43, 0.10);
}
.city-item:active { background: rgba(139, 90, 43, 0.04); }
.city-seq {
  flex-shrink: 0;
  width: 46rpx;
  height: 46rpx;
  line-height: 46rpx;
  text-align: center;
  border-radius: 8rpx;
  background: rgba(176, 123, 62, 0.92);
  color: #f5e9d5;
  font-size: 24rpx;
  font-family: 'STKaiti', 'KaiTi', serif;
}
.city-seq-key { background: rgba(158, 42, 43, 0.92); }
.city-body {
  flex: 1;
  min-width: 0;
  margin-left: 18rpx;
}
.city-sub {
  font-size: 28rpx;
  color: #4a3220;
  font-family: 'STKaiti', 'KaiTi', serif;
  letter-spacing: 1rpx;
}
.city-meta {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #9a7d54;
}
.city-item.locked .city-sub,
.city-item.locked .city-meta { color: #bdb0a0; }
.city-action {
  flex-shrink: 0;
  margin-left: 14rpx;
  padding: 10rpx 16rpx;
  border-radius: 26rpx;
  border: 2rpx solid #d8c6a7;
  font-size: 21rpx;
  color: #8b5a2b;
  background: rgba(255, 253, 247, 0.72);
}
.city-item.locked .city-action {
  color: #bdb0a0;
  border-color: #e6dcc8;
  background: rgba(247, 239, 221, 0.6);
}

/* ============ 已完成旅程（程级诗笺入口） ============ */
.review-section {
  margin: 34rpx 24rpx 0;
  padding: 28rpx 26rpx 12rpx;
  background: linear-gradient(135deg, #fffdf7 0%, #f7efdd 100%);
  border: 2rpx solid #e6dcc8;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 14rpx rgba(139, 90, 43, 0.12);
}
.review-title {
  font-size: 32rpx;
  color: #4a3220;
  font-family: 'STKaiti', 'KaiTi', serif;
  letter-spacing: 4rpx;
}
.review-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #9a7d54;
  line-height: 1.5;
}
.review-list { margin-top: 18rpx; }
.review-item {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-top: 2rpx solid rgba(139, 90, 43, 0.10);
}
.review-seal {
  flex-shrink: 0;
  width: 54rpx;
  height: 54rpx;
  line-height: 54rpx;
  text-align: center;
  border-radius: 8rpx;
  background: linear-gradient(135deg, #8b5a2b, #b07b3e);
  color: #f5e9d5;
  font-size: 28rpx;
  font-family: 'STKaiti', 'KaiTi', serif;
}
.review-body {
  flex: 1;
  min-width: 0;
  margin-left: 18rpx;
}
.review-name {
  font-size: 27rpx;
  color: #4a3220;
  font-family: 'STKaiti', 'KaiTi', serif;
  letter-spacing: 1rpx;
}
.review-meta {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #9a7d54;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.review-action {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 12rpx 18rpx;
  border-radius: 28rpx;
  border: 2rpx solid #d8c6a7;
  font-size: 22rpx;
  color: #8b5a2b;
  background: rgba(255, 253, 247, 0.72);
}
.review-action:active { opacity: 0.7; }

.foot-note {
  margin-top: 30rpx;
  text-align: center;
  font-size: 22rpx;
  color: #b5a892;
  letter-spacing: 2rpx;
}
