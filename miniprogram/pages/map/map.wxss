/* pages/map/map.wxss —— 行迹地图（水墨舆图 · 暖棕古风） */

.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #3b2d1c 0%, #5a4230 420rpx, #f5f0e8 720rpx, #efe7d8 100%);
  padding-bottom: 60rpx;
}

/* ============ 顶部 ============ */
.map-head {
  padding: 56rpx 32rpx 28rpx;
}
.head-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}
.head-title {
  font-size: 52rpx;
  color: #f0e6d2;
  font-family: 'STKaiti', 'KaiTi', serif;
  letter-spacing: 8rpx;
}
.head-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: rgba(240, 230, 210, 0.62);
  letter-spacing: 2rpx;
}
.head-btn {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  padding: 10rpx 20rpx 10rpx 12rpx;
  border: 2rpx solid rgba(240, 230, 210, 0.45);
  border-radius: 40rpx;
  background: rgba(240, 230, 210, 0.08);
}
.head-btn:active { opacity: 0.7; }
.head-btn-seal {
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 6rpx;
  background: #9e2a2b;
  color: #f5e9d5;
  font-size: 24rpx;
  font-family: 'STKaiti', 'KaiTi', serif;
  margin-right: 10rpx;
}
.head-btn-text {
  font-size: 24rpx;
  color: #f0e6d2;
  font-family: 'STKaiti', 'KaiTi', serif;
  letter-spacing: 2rpx;
}

/* 切换条 */
.line-tabs {
  margin-top: 30rpx;
  display: flex;
}
.tab {
  padding: 14rpx 40rpx;
  margin-right: 20rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  color: rgba(240, 230, 210, 0.7);
  background: rgba(240, 230, 210, 0.08);
  border: 2rpx solid rgba(240, 230, 210, 0.18);
  font-family: 'STKaiti', 'KaiTi', serif;
  letter-spacing: 3rpx;
  transition: all 0.2s ease;
}
.tab.on {
  color: #3b2d1c;
  background: linear-gradient(135deg, #f0e6d2, #d9c7a3);
  border-color: transparent;
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.22);
}

/* 进度总览 */
.progress-wrap {
  margin-top: 26rpx;
  display: flex;
  align-items: center;
}
.progress-bar {
  flex: 1;
  height: 12rpx;
  background: rgba(240, 230, 210, 0.22);
  border-radius: 6rpx;
  overflow: hidden;
}
.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #d9b06a 0%, #b07b3e 100%);
  border-radius: 6rpx;
  transition: width 0.5s ease;
}
.progress-text {
  margin-left: 18rpx;
  font-size: 24rpx;
  color: rgba(240, 230, 210, 0.85);
  letter-spacing: 1rpx;
  white-space: nowrap;
}

/* ============ 地图（纸面） ============ */
.map-wrap {
  margin: 0 24rpx;
  padding: 14rpx;
  background: linear-gradient(180deg, #f8f2e3 0%, #f3ebd8 100%);
  border: 3rpx solid #e0d2b6;
  border-radius: 18rpx;
  box-shadow: 0 8rpx 24rpx rgba(59, 45, 28, 0.28);
}

.map-stage {
  position: relative;
  width: 100%;
  overflow: hidden;
  border-radius: 10rpx;
  background: #f7f1e2;
}
.map-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

/* -------- 降级层：纯 CSS 水墨示意 -------- */
.map-fallback {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  overflow: hidden;
  background:
    radial-gradient(ellipse 46% 26% at 26% 14%, rgba(90, 66, 48, 0.20), rgba(90, 66, 48, 0) 72%),
    radial-gradient(ellipse 40% 24% at 20% 30%, rgba(90, 66, 48, 0.15), rgba(90, 66, 48, 0) 72%),
    radial-gradient(ellipse 34% 20% at 34% 66%, rgba(90, 66, 48, 0.13), rgba(90, 66, 48, 0) 74%),
    radial-gradient(ellipse 30% 18% at 14% 82%, rgba(90, 66, 48, 0.12), rgba(90, 66, 48, 0) 74%),
    radial-gradient(ellipse 50% 30% at 88% 12%, rgba(78, 104, 122, 0.10), rgba(78, 104, 122, 0) 76%),
    linear-gradient(158deg, #f9f4e6 0%, #f4ecda 58%, #ede2cc 100%);
}
.fb-grid {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  opacity: 0.55;
  background-image:
    linear-gradient(rgba(139, 90, 43, 0.07) 1rpx, transparent 1rpx),
    linear-gradient(90deg, rgba(139, 90, 43, 0.07) 1rpx, transparent 1rpx);
  background-size: 12.5% 12.5%;
}
.fb-blob {
  position: absolute;
  border-radius: 50%;
  filter: blur(10rpx);
}
.fb-blob.b1 {
  left: 6%;
  top: 4%;
  width: 46%;
  height: 22%;
  background: radial-gradient(ellipse at 40% 60%, rgba(74, 54, 38, 0.22), rgba(74, 54, 38, 0) 72%);
  transform: rotate(-12deg);
}
.fb-blob.b2 {
  left: 2%;
  top: 24%;
  width: 40%;
  height: 20%;
  background: radial-gradient(ellipse at 50% 50%, rgba(74, 54, 38, 0.16), rgba(74, 54, 38, 0) 72%);
  transform: rotate(8deg);
}
.fb-blob.b3 {
  left: 14%;
  top: 44%;
  width: 34%;
  height: 16%;
  background: radial-gradient(ellipse at 50% 50%, rgba(74, 54, 38, 0.13), rgba(74, 54, 38, 0) 74%);
  transform: rotate(-5deg);
}
.fb-blob.b4 {
  right: 4%;
  top: 8%;
  width: 34%;
  height: 22%;
  background: radial-gradient(ellipse at 50% 50%, rgba(78, 104, 122, 0.12), rgba(78, 104, 122, 0) 74%);
}
/* 江河：用大圆角边框画弧线 */
.fb-river {
  position: absolute;
  border-top: 3rpx solid rgba(78, 104, 122, 0.26);
  border-radius: 50% 50% 0 0 / 100% 100% 0 0;
}
.fb-river.r1 {
  left: 4%;
  top: 34%;
  width: 74%;
  height: 90rpx;
  transform: rotate(-7deg);
}
.fb-river.r2 {
  left: 8%;
  top: 52%;
  width: 82%;
  height: 110rpx;
  border-top-color: rgba(78, 104, 122, 0.32);
  transform: rotate(6deg);
}
.fb-river.r3 {
  left: 30%;
  top: 70%;
  width: 62%;
  height: 80rpx;
  transform: rotate(-10deg);
}
.fb-tip {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 10rpx;
  text-align: center;
  font-size: 20rpx;
  color: rgba(139, 90, 43, 0.45);
  letter-spacing: 2rpx;
}

/* -------- 路线层 -------- */
.route-layer {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
  z-index: 2;
}
.seg {
  position: absolute;
  height: 3rpx;
  margin-top: -1.5rpx;
  transform-origin: 0 50%;
  border-radius: 2rpx;
}
.seg-lit {
  background: linear-gradient(90deg, rgba(139, 90, 43, 0.8), rgba(176, 123, 62, 0.62));
  box-shadow: 0 0 6rpx rgba(139, 90, 43, 0.45);
  animation: inkSpread 0.8s ease-out both;
}
.seg-next {
  background: repeating-linear-gradient(90deg, rgba(176, 123, 62, 0.65) 0, rgba(176, 123, 62, 0.65) 12rpx, transparent 12rpx, transparent 26rpx);
  animation: inkSpread 1s ease-out both;
}
.seg-locked {
  background: repeating-linear-gradient(90deg, rgba(160, 140, 107, 0.34) 0, rgba(160, 140, 107, 0.34) 8rpx, transparent 8rpx, transparent 22rpx);
}
@keyframes inkSpread {
  from { opacity: 0; filter: blur(7rpx); }
  to { opacity: 1; filter: blur(0); }
}

/* -------- 地点层 -------- */
.wp-layer {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 3;
}
.wp {
  position: absolute;
  width: 60rpx;
  height: 60rpx;
  transform: translate(-50%, -50%);
}
.wp-dot {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 26rpx;
  height: 26rpx;
  margin: -13rpx 0 0 -13rpx;
}
.wp-core {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  border-radius: 50%;
  background: radial-gradient(circle at 34% 30%, #d5c8b3, #b3a390);
  border: 2rpx solid #9d8c77;
  box-shadow: 0 2rpx 6rpx rgba(74, 50, 32, 0.28);
}
.wp.completed .wp-core {
  background: radial-gradient(circle at 34% 30%, #cf9243, #8b5a2b);
  border-color: #6b4420;
  box-shadow: 0 0 12rpx rgba(176, 123, 62, 0.75);
  animation: dotInk 0.7s ease-out both;
}
.wp.active .wp-core {
  background: radial-gradient(circle at 34% 30%, #e0ab4e, #a9662a);
  border-color: #8b5a2b;
  box-shadow: 0 0 14rpx rgba(200, 140, 60, 0.8);
}
@keyframes dotInk {
  from { opacity: 0; transform: scale(0.4); filter: blur(4rpx); }
  to { opacity: 1; transform: scale(1); filter: blur(0); }
}
.wp.active .wp-pulse {
  position: absolute;
  left: -10rpx;
  top: -10rpx;
  right: -10rpx;
  bottom: -10rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(200, 140, 60, 0.85);
  animation: wpPulse 1.8s ease-out infinite;
}
@keyframes wpPulse {
  0% { transform: scale(0.65); opacity: 0.95; }
  100% { transform: scale(2.1); opacity: 0; }
}

/* 地点名 */
.wp-label {
  position: absolute;
  left: 50%;
  top: 46rpx;
  transform: translateX(-50%);
  white-space: nowrap;
  font-size: 20rpx;
  color: #a08c6b;
  font-family: 'STKaiti', 'KaiTi', serif;
  letter-spacing: 1rpx;
}
.wp.completed .wp-label,
.wp.active .wp-label {
  color: #5a4227;
  font-weight: 600;
}
.wp.locked .wp-label { color: #bdb0a0; }
.wp.lp-top .wp-label { top: auto; bottom: 46rpx; }
.wp.lp-left .wp-label { left: auto; right: 46rpx; top: 50%; transform: translateY(-50%); }
.wp.lp-right .wp-label { left: 46rpx; top: 50%; transform: translateY(-50%); }

/* 图例 */
.legend {
  display: flex;
  justify-content: center;
  padding: 18rpx 0 4rpx;
}
.legend-item {
  display: flex;
  align-items: center;
  margin: 0 18rpx;
  font-size: 22rpx;
  color: #8c7b6b;
}
.legend-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 8rpx;
}
.legend-dot.done { background: linear-gradient(135deg, #cf9243, #8b5a2b); }
.legend-dot.now { background: linear-gradient(135deg, #e0ab4e, #a9662a); box-shadow: 0 0 8rpx rgba(200, 140, 60, 0.8); }
.legend-dot.lock { background: #c2b5a2; }

.map-caption {
  padding: 12rpx 12rpx 6rpx;
  font-size: 23rpx;
  line-height: 1.7;
  color: #7a6446;
  font-family: 'STKaiti', 'KaiTi', serif;
  letter-spacing: 1rpx;
  text-align: center;
}

/* ============ 地点卡片 ============ */
.card-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  background: rgba(40, 28, 16, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 48rpx;
}
.wp-card {
  position: relative;
  width: 100%;
  max-width: 620rpx;
  max-height: 84vh;
  overflow: hidden;
  border-radius: 16rpx;
  background: linear-gradient(180deg, #f8f2e3 0%, #f3ebd8 100%);
  border: 3rpx solid #e0d2b6;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.45);
  animation: cardIn 0.22s ease-out both;
}
@keyframes cardIn {
  from { opacity: 0; transform: translateY(24rpx) scale(0.97); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}
.wp-card-seal {
  position: absolute;
  top: 18rpx;
  right: 18rpx;
  z-index: 2;
  width: 54rpx;
  height: 54rpx;
  line-height: 54rpx;
  text-align: center;
  border-radius: 8rpx;
  background: rgba(158, 42, 43, 0.9);
  color: #f5e9d5;
  font-size: 30rpx;
  font-family: 'STKaiti', 'KaiTi', serif;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.25);
}
.wp-card-scene {
  height: 230rpx;
  overflow: hidden;
}
.wp-card-img {
  width: 100%;
  height: 100%;
}
.img-locked { filter: grayscale(0.9) brightness(0.85); }

.wp-card-body {
  padding: 26rpx 30rpx 30rpx;
}
.wp-card-name {
  font-size: 42rpx;
  color: #4a3220;
  font-family: 'STKaiti', 'KaiTi', serif;
  letter-spacing: 4rpx;
}
.wp-card-meta {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #9a7d54;
  letter-spacing: 1rpx;
}
.wp-card-state {
  display: inline-block;
  margin-top: 14rpx;
  padding: 4rpx 18rpx;
  border-radius: 24rpx;
  font-size: 21rpx;
  color: #fff;
}
.wp-card-state.completed { background: rgba(107, 142, 90, 0.92); }
.wp-card-state.active { background: rgba(176, 123, 62, 0.92); }
.wp-card-state.locked { background: rgba(160, 140, 107, 0.85); }

.wp-card-note {
  margin-top: 18rpx;
  font-size: 26rpx;
  line-height: 1.72;
  color: #4a3a28;
}
.wp-card-poem {
  margin-top: 20rpx;
  padding: 18rpx 20rpx;
  border-left: 5rpx solid #b07b3e;
  background: rgba(176, 123, 62, 0.09);
  border-radius: 0 10rpx 10rpx 0;
}
.poem-text {
  display: block;
  font-size: 29rpx;
  color: #7a4a1c;
  font-family: 'STKaiti', 'KaiTi', serif;
  letter-spacing: 2rpx;
  line-height: 1.6;
}
.poem-src {
  display: block;
  margin-top: 8rpx;
  font-size: 21rpx;
  color: #a08c6b;
  text-align: right;
}
.wp-card-anchor {
  margin-top: 16rpx;
  font-size: 23rpx;
  color: #6b8e5a;
  letter-spacing: 1rpx;
}

.wp-card-actions {
  margin-top: 26rpx;
  display: flex;
  align-items: center;
}
.act {
  padding: 16rpx 30rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
}
.act-main {
  flex: 1;
  text-align: center;
  color: #fff;
  background: linear-gradient(135deg, #8b5a2b, #a9743c);
  box-shadow: 0 4rpx 14rpx rgba(139, 90, 43, 0.28);
}
.act-main:active { opacity: 0.85; }
.act-ghost {
  margin-left: 18rpx;
  color: #8c7b6b;
  border: 2rpx solid #ded0b6;
  background: transparent;
}
.act-ghost:active { opacity: 0.7; }

/* ============ 底部诗笺入口 ============ */
.poem-entry {
  margin: 34rpx 24rpx 0;
  padding: 26rpx 26rpx;
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #fffdf7 0%, #f7efdd 100%);
  border: 2rpx solid #e6dcc8;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 14rpx rgba(139, 90, 43, 0.12);
}
.poem-entry:active { transform: scale(0.99); }
.poem-entry-seal {
  flex-shrink: 0;
  width: 68rpx;
  height: 68rpx;
  line-height: 68rpx;
  text-align: center;
  border-radius: 10rpx;
  background: linear-gradient(135deg, #9e2a2b, #c0392b);
  color: #f5e9d5;
  font-size: 36rpx;
  font-family: 'STKaiti', 'KaiTi', serif;
  box-shadow: 0 4rpx 12rpx rgba(158, 42, 43, 0.3);
}
.poem-entry-text {
  flex: 1;
  margin-left: 22rpx;
}
.poem-entry-title {
  font-size: 32rpx;
  color: #4a3220;
  font-family: 'STKaiti', 'KaiTi', serif;
  letter-spacing: 4rpx;
}
.poem-entry-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #9a7d54;
  line-height: 1.5;
}
.poem-entry-arrow {
  flex-shrink: 0;
  font-size: 40rpx;
  color: #b5a892;
}

.foot-note {
  margin-top: 30rpx;
  text-align: center;
  font-size: 22rpx;
  color: #b5a892;
  letter-spacing: 2rpx;
}
