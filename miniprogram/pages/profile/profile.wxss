/* pages/profile/profile.wxss —— 我的（视觉重做版） */
.page {
  min-height: 100vh;
  padding-bottom: 60rpx;
}

/* ===== 头部：暖棕渐变 + 古风头像 ===== */
.profile-head {
  padding: 70rpx 40rpx 56rpx;
  text-align: center;
  background: linear-gradient(180deg, #3b2d1c 0%, #5a4230 55%, #f5f0e8 100%);
}
.avatar {
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #8b5a2b, #b8860b);
  color: #fff8ea;
  font-size: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto;
  font-family: 'STKaiti', 'KaiTi', serif;
  box-shadow: 0 6rpx 18rpx rgba(0, 0, 0, 0.25);
  border: 3rpx solid rgba(255, 248, 234, 0.55);
}
.name-row {
  margin-top: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.name {
  font-size: 38rpx;
  color: #fff8ea;
  font-family: 'STKaiti', 'KaiTi', serif;
  letter-spacing: 4rpx;
}
.edit-icon {
  margin-left: 12rpx;
  font-size: 30rpx;
  color: rgba(255, 248, 234, 0.7);
}
.login-tag {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: rgba(255, 248, 234, 0.55);
  letter-spacing: 2rpx;
}

/* ===== 学习成果：三格数字 ===== */
.summary-card {
  margin-top: -28rpx;
}
.summary-grid {
  display: flex;
}
.summary-item {
  flex: 1;
  text-align: center;
}
.summary-item:active { opacity: 0.6; }
.summary-item + .summary-item {
  border-left: 1rpx solid var(--color-border);
}
.summary-num {
  display: block;
  font-size: 46rpx;
  color: var(--color-primary);
  font-weight: 600;
  font-family: 'STKaiti', 'KaiTi', serif;
}
.summary-total {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  font-weight: normal;
}
.summary-label {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
  letter-spacing: 2rpx;
}

/* ===== 分区标题 ===== */
.section-title {
  font-size: 32rpx;
  margin-bottom: 24rpx;
}

/* ===== 三条人物线 · 我的角色卡片 ===== */
.role-card-body {
  display: flex;
  align-items: center;
  padding: 20rpx 4rpx;
}
.role-card-body + .role-card-body {
  border-top: 1rpx solid #efe7d3;
}
.role-card-line {
  flex-shrink: 0;
  width: 88rpx;
  margin-right: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #8b5a2b;
  font-family: 'STKaiti', 'KaiTi', serif;
  text-align: center;
}
.role-card-portrait {
  width: 108rpx;
  height: 108rpx;
  flex-shrink: 0;
  margin-right: 24rpx;
  border-radius: 14rpx;
  overflow: hidden;
  background: #ece1ca;
  border: 1rpx solid #d8c9a8;
  display: flex;
  align-items: center;
  justify-content: center;
}
.role-card-img { width: 100%; height: 100%; }
.role-card-silhouette {
  width: 56rpx;
  height: 56rpx;
  position: relative;
}
.role-card-silhouette::before {
  content: '';
  position: absolute;
  left: 50%;
  top: 0;
  transform: translateX(-50%);
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  background: #6b5a3e;
}
.role-card-silhouette::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 20rpx;
  transform: translateX(-50%);
  width: 42rpx;
  height: 36rpx;
  border-radius: 20rpx 20rpx 6rpx 6rpx;
  background: #6b5a3e;
}
.role-card-info {
  flex: 1;
  min-width: 0;
}
.role-card-empty {
  font-size: 28rpx;
  color: var(--color-text-secondary);
}
/* 档案损坏态：用朱色提示「需修复」，与「尚未创建」在视觉上区分开 */
.role-card-invalid {
  color: #a33a2b;
  font-family: 'STKaiti', 'KaiTi', serif;
}
.role-card-name {
  font-size: 30rpx;
  color: var(--color-text);
  font-family: 'STKaiti', 'KaiTi', serif;
  font-weight: 600;
}
.role-card-avatar {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}
.role-card-note {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #a99b88;
}
.role-card-action {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  padding: 10rpx 20rpx;
  border: 1rpx solid #c9a86a;
  border-radius: 999rpx;
}
.role-card-action-text {
  font-size: 24rpx;
  color: #8b5a2b;
}
.role-card-arrow {
  margin-left: 6rpx;
  font-size: 28rpx;
  color: #8b5a2b;
}

/* ===== 设置行 ===== */
.setting-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 4rpx;
  border-bottom: 1rpx solid var(--color-border);
}
.setting-row:last-child {
  border-bottom: none;
}
.contact-row {
  width: 100%;
  margin: 0;
  border-radius: 0;
  background: transparent;
  box-sizing: border-box;
  line-height: normal;
  text-align: left;
}
.contact-row::after {
  border: none;
}
.setting-label {
  font-size: 28rpx;
  color: var(--color-text);
}
.setting-arrow {
  font-size: 34rpx;
  color: var(--color-text-secondary);
}

/* ===== 底部重置入口 ===== */
.reset-link {
  margin-top: 56rpx;
  text-align: center;
  font-size: 24rpx;
  color: #b5a892;
  text-decoration: underline;
}

.delete-link {
  margin-top: 28rpx;
  text-align: center;
  font-size: 24rpx;
  color: #a33a32;
  text-decoration: underline;
}
.delete-link.disabled {
  opacity: 0.45;
}
.delete-hint {
  margin: 12rpx 48rpx 0;
  text-align: center;
  font-size: 20rpx;
  line-height: 1.6;
  color: #a99b88;
}
