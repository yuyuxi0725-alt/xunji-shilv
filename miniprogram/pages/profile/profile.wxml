<!-- pages/profile/profile.wxml —— 我的（个人信息 + 学习成果 + 设置） -->
<view class="page">

  <!-- 头部：头像 + 昵称（可改）+ 登录状态 -->
  <view class="profile-head">
    <view class="avatar" bindtap="onEditNickname">{{avatarText}}</view>
    <view class="name-row" bindtap="onEditNickname">
      <text class="name">{{nickname}}</text>
      <text class="edit-icon">✎</text>
    </view>
    <view class="login-tag">{{loggedIn ? '学习进度已同步' : (identityConnecting ? '正在连接学习档案…' : '未同步 · 请先在首页确认年龄和协议')}}</view>
  </view>

  <!-- 学习成果总览 -->
  <view class="card summary-card">
    <view class="section-title gufeng-title">学习成果</view>
    <view class="summary-grid">
      <view class="summary-item" bindtap="onTapSummary" data-target="story">
        <text class="summary-num">{{summary.lines}}</text>
        <text class="summary-label">同行古人</text>
      </view>
      <view class="summary-item" bindtap="onTapSummary" data-target="map">
        <text class="summary-num">{{summary.completed}}<text class="summary-total">/{{summary.total}}</text></text>
        <text class="summary-label">完成旅程</text>
      </view>
      <view class="summary-item" bindtap="onTapSummary" data-target="poem">
        <text class="summary-num">{{summary.anchorsGot}}<text class="summary-total">/{{summary.anchorsTotal}}</text></text>
        <text class="summary-label">知识印章</text>
      </view>
    </view>
  </view>

  <!-- 三条人物线 · 我的角色（剧情中的名字，与账号昵称分开，各线档案独立） -->
  <view class="card role-card" wx:if="{{showRoleSection}}">
    <view class="section-title gufeng-title">我的角色</view>
    <view
      class="role-card-body"
      wx:for="{{roleCards}}"
      wx:key="lineId"
      data-lineId="{{item.lineId}}"
      bindtap="onRoleCardTap"
    >
      <view class="role-card-line">{{item.lineName}}线</view>
      <view class="role-card-portrait">
        <image wx:if="{{item.portraitImage}}" class="role-card-img" src="{{item.portraitImage}}" mode="aspectFit" />
        <view class="role-card-silhouette" wx:else></view>
      </view>
      <view class="role-card-info">
        <view wx:if="{{item.status === 'none'}}" class="role-card-empty">尚未创建角色</view>
        <view wx:elif="{{item.status === 'invalid'}}" class="role-card-empty role-card-invalid">{{item.displayName}}</view>
        <block wx:else>
          <view class="role-card-name">{{item.displayName}}</view>
          <view class="role-card-avatar">{{item.avatarName}}</view>
        </block>
        <view class="role-card-note">剧情中的名字 · 与账号昵称无关，不影响学习进度</view>
      </view>
      <view class="role-card-action">
        <text class="role-card-action-text">{{item.label}}</text>
        <text class="role-card-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 设置 -->
  <view class="card">
    <view class="section-title gufeng-title">设置</view>
    <view class="setting-row">
      <text class="setting-label">背景音乐</text>
      <switch checked="{{bgmOn}}" bindchange="onToggleBgm" color="#8b5a2b" />
    </view>
    <view class="setting-row" bindtap="onAbout">
      <text class="setting-label">关于寻迹诗旅</text>
      <text class="setting-arrow">›</text>
    </view>
    <navigator class="setting-row" url="/pages/agreement/agreement">
      <text class="setting-label">用户服务协议</text>
      <text class="setting-arrow">›</text>
    </navigator>
    <view class="setting-row" bindtap="onOpenPrivacy">
      <text class="setting-label">隐私政策</text>
      <text class="setting-arrow">›</text>
    </view>
    <button
      class="setting-row contact-row"
      open-type="contact"
      session-from="profile-support"
      show-message-card
      send-message-title="寻迹诗旅客服、投诉与举报"
      send-message-path="/pages/profile/profile"
    >
      <text class="setting-label">客服、投诉与举报</text>
      <text class="setting-arrow">›</text>
    </button>
  </view>

  <view class="reset-link" bindtap="onResetProgress">清除进度，重新开始</view>
  <view
    wx:if="{{loggedIn}}"
    class="delete-link {{deletingAccount ? 'disabled' : ''}}"
    bindtap="onDeleteAccount"
  >{{deletingAccount ? '正在删除学习档案…' : '删除学习档案'}}</view>
  <view wx:if="{{loggedIn}}" class="delete-hint">永久删除云端身份记录及本机数据，删除后无法恢复</view>
</view>
