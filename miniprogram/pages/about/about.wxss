/* pages/about/about.wxss —— 关于页（古风暖色调，与协议页统一） */
page {
  height: 100%;
  background: #f5f0e8;
}
.about-page {
  height: 100%;
  color: #3f3429;
}
.paper {
  margin: 28rpx;
  padding: 48rpx 34rpx 64rpx;
  background: #fffdf7;
  border: 1rpx solid #e2d5c1;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 28rpx rgba(82, 57, 31, 0.08);
}

/* ===== 头部品牌区 ===== */
.brand {
  text-align: center;
  padding-bottom: 36rpx;
  border-bottom: 1rpx solid #e2d5c1;
}
.brand-name {
  color: #5e3d21;
  font-size: 46rpx;
  font-weight: 700;
  font-family: 'STKaiti', 'KaiTi', serif;
  letter-spacing: 6rpx;
}
.brand-slogan {
  margin-top: 16rpx;
  color: #8b5a2b;
  font-size: 26rpx;
  font-family: 'STKaiti', 'KaiTi', serif;
  letter-spacing: 3rpx;
}
.brand-version {
  margin-top: 14rpx;
  color: #a99b88;
  font-size: 22rpx;
}

/* ===== 通用分区 ===== */
.section {
  margin-top: 38rpx;
}
.section-title {
  color: #6b4423;
  font-size: 31rpx;
  font-weight: 700;
}
.paragraph {
  margin-top: 12rpx;
  font-size: 28rpx;
  line-height: 1.85;
  text-align: justify;
}

/* ===== 备案信息公示框（显著位置，深色描边突出） ===== */
.beian-box {
  margin-top: 16rpx;
  padding: 28rpx;
  background: #f8f1e5;
  border: 1rpx solid #e0cdb0;
  border-radius: 14rpx;
}
.beian-row {
  display: flex;
  align-items: baseline;
  padding: 8rpx 0;
}
.beian-label {
  flex-shrink: 0;
  margin-right: 20rpx;
  color: #8c7b6b;
  font-size: 26rpx;
}
.beian-value {
  color: #4a3523;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  word-break: break-all;
}
.beian-actions {
  display: flex;
  margin-top: 22rpx;
}
.beian-btn {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  color: #8b5a2b;
  font-size: 26rpx;
  border: 1rpx solid #c9a86a;
  border-radius: 10rpx;
  background: #fffdf7;
}
.beian-btn + .beian-btn {
  margin-left: 20rpx;
}
.beian-btn:active {
  background: #f0e3c8;
}
.beian-hint {
  margin-top: 18rpx;
  color: #a99b88;
  font-size: 22rpx;
  line-height: 1.6;
}

/* ===== 页脚 ===== */
.footer {
  margin-top: 46rpx;
  padding-top: 26rpx;
  border-top: 1rpx solid #e2d5c1;
  color: #8b5a2b;
  font-size: 25rpx;
  text-align: center;
}
